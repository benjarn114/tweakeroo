                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- List -->      <DockPanel x:Name="ListPage" Grid.Column="1" Visibility="Collapsed">
        <StackPanel DockPanel.Dock="Top" Margin="28,24,28,14">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
