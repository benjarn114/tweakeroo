            <DataTemplate>
              <Border Background="{DynamicResource Card}" CornerRadius="18" Padding="16,14" Margin="0,0,19,8">
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding Info}" FontSize="13" Foreground="{DynamicResource Ink2}" TextWrapping="Wrap" Margin="0,3,0,10" Typography.NumeralAlignment="Tabular"/>
                  <WrapPanel>
                    <t:Btn Style="{StaticResource Btn}" Icon="{StaticResource IcoUndo}" Content="{Binding RestoreText}" CommandParameter="restore" Height="38" Padding="13,0" FontSize="14" IsEnabled="{Binding CanRestore}" Margin="0,0,6,0"/>
                    <t:Btn Style="{StaticResource Btn}" Icon="{StaticResource IcoTrash}" Content="{Binding DeleteText}" CommandParameter="delete" Height="38" Padding="11,0" FontSize="14" Visibility="{Binding CanDelete, Converter={StaticResource Vis}}"/>
                  </WrapPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        </Grid>
      </DockPanel>

      <!-- Carga -->
      <Border x:Name="SkelPage" Grid.Column="1" Background="{DynamicResource Bg}" Padding="28,30,28,0" Visibility="Collapsed">
        <StackPanel>
          <ContentControl Style="{StaticResource Skel}" Width="380" Height="34"/>
          <ContentControl Style="{StaticResource Skel}" Width="500" Height="18" Margin="0,14,0,0"/>
          <ContentControl Style="{StaticResource Skel}" Width="240" Height="60" Margin="0,22,0,28"/>
          <ContentControl Style="{StaticResource Skel}" HorizontalAlignment="Stretch" Height="16" Margin="0,0,0,30"/>
          <UniformGrid Columns="2" Margin="0,0,-10,0">
            <ContentControl Style="{StaticResource Skel}" HorizontalAlignment="Stretch" Height="88" Margin="0,0,10,10"/>
            <ContentControl Style="{StaticResource Skel}" HorizontalAlignment="Stretch" Height="88" Margin="0,0,10,10"/>
            <ContentControl Style="{StaticResource Skel}" HorizontalAlignment="Stretch" Height="88" Margin="0,0,10,10"/>
            <ContentControl Style="{StaticResource Skel}" HorizontalAlignment="Stretch" Height="88" Margin="0,0,10,10"/>
            <ContentControl Style="{StaticResource Skel}" HorizontalAlignment="Stretch" Height="88" Margin="0,0,10,10"/>
            <ContentControl Style="{StaticResource Skel}" HorizontalAlignment="Stretch" Height="88" Margin="0,0,10,10"/>
          </UniformGrid>
        </StackPanel>
