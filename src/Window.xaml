<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t="clr-namespace:Tablero;assembly={{ASM}}"
        Title="Tweakeroo" Width="1320" Height="840" MinWidth="1200" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}"
        FontFamily="Bahnschrift, Segoe UI" FontSize="14" UseLayoutRounding="True">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Vis"/>

    <!-- Iconos: trazo unico de 2 sobre una rejilla de 24 -->
    <Geometry x:Key="IcoPc">M3,4 H21 V16 H3 Z M9,20 H15 M12,16 V20</Geometry>
    <Geometry x:Key="IcoAll">M4,4 H10 V10 H4 Z M14,4 H20 V10 H14 Z M4,14 H10 V20 H4 Z M14,14 H20 V20 H14 Z</Geometry>
    <Geometry x:Key="IcoGame">M7,7 H17 A5,5 0 0 1 22,12 V15 A3,3 0 0 1 16.5,16.5 L15,15 H9 L7.5,16.5 A3,3 0 0 1 2,15 V12 A5,5 0 0 1 7,7 Z M7,10 V13 M5.5,11.5 H8.5 M16,10.5 V10.6 M18,12.5 V12.6</Geometry>
    <Geometry x:Key="IcoGpu">M2,6 H22 V17 H2 Z M5,17 V20 H13 V17 M8,11.5 A2.5,2.5 0 1 0 13,11.5 A2.5,2.5 0 1 0 8,11.5 M17,9 V14</Geometry>
    <Geometry x:Key="IcoBolt">M13,2 L5,14 H11 L10,22 L19,9 H13 Z</Geometry>
    <Geometry x:Key="IcoMouse">M12,2 A6,6 0 0 1 18,8 V16 A6,6 0 0 1 6,16 V8 A6,6 0 0 1 12,2 Z M12,6 V10</Geometry>
    <Geometry x:Key="IcoNet">M2,9 A14,14 0 0 1 22,9 M5.5,13 A9,9 0 0 1 18.5,13 M9,16.5 A4.5,4.5 0 0 1 15,16.5 M12,20 V20.1</Geometry>
    <Geometry x:Key="IcoLayers">M12,3 L22,8 L12,13 L2,8 Z M2,13 L12,18 L22,13</Geometry>
    <Geometry x:Key="IcoServer">M3,4 H21 V10 H3 Z M3,14 H21 V20 H3 Z M7,7 V7.1 M7,17 V17.1</Geometry>
    <Geometry x:Key="IcoClock">M12,3 A9,9 0 1 1 11.99,3 Z M12,7 V12 L15.5,14</Geometry>
    <Geometry x:Key="IcoBell">M6,16 V11 A6,6 0 0 1 18,11 V16 L20,18 H4 Z M10,21 H14</Geometry>
    <Geometry x:Key="IcoTag">M3,12 V3 H12 L21,12 L12,21 Z M7.5,7.5 V7.6</Geometry>
    <Geometry x:Key="IcoSearch">M10.5,4 A6.5,6.5 0 1 1 10.49,4 Z M15.5,15.5 L21,21</Geometry>
    <Geometry x:Key="IcoEye">M2,12 C6,5 18,5 22,12 C18,19 6,19 2,12 Z M12,9.5 A2.5,2.5 0 1 1 11.99,9.5 Z</Geometry>
    <Geometry x:Key="IcoWindow">M3,4 H21 V20 H3 Z M3,9 H21</Geometry>
    <Geometry x:Key="IcoUndo">M8,5 L4,9 L8,13 M4,9 H14 A5.5,5.5 0 0 1 14,20 H9</Geometry>
    <Geometry x:Key="IcoSave">M12,4 V15 M7,10.5 L12,15 L17,10.5 M4,20 H20</Geometry>
    <Geometry x:Key="IcoTrash">M4,7 H20 M9,7 V4 H15 V7 M6,7 L7,20 H17 L18,7</Geometry>
    <Geometry x:Key="IcoScan">M4,8 V4 H8 M16,4 H20 V8 M20,16 V20 H16 M8,20 H4 V16 M3,12 H21</Geometry>
    <Geometry x:Key="LogoEarsShape">M20,4 C27,6 30,16 29.5,27 L21,30 C14,22 13,10 20,4 Z M44,4 C37,6 34,16 34.5,27 L43,30 C50,22 51,10 44,4 Z</Geometry>
    <Geometry x:Key="LogoInner">M21.5,10 C25,14 26,20 25.6,25.5 L22,27 C18.5,21 18.5,14 21.5,10 Z M42.5,10 C39,14 38,20 38.4,25.5 L42,27 C45.5,21 45.5,14 42.5,10 Z</Geometry>
    <Geometry x:Key="LogoHead">M32,24 C43,24 50,31 49,40 C48,48 41,52 38,58 C36.5,61 27.5,61 26,58 C23,52 16,48 15,40 C14,31 21,24 32,24 Z</Geometry>
    <Geometry x:Key="LogoFace">M24,37 A3,3 0 1 1 23.99,37 Z M40,37 A3,3 0 1 1 39.99,37 Z M27.5,51 H36.5 L32,56 Z</Geometry>
    <Geometry x:Key="IcoCheck">M4,12.5 L9.5,18 L20,6.5</Geometry>
    <Geometry x:Key="IcoPower">M12,3 V11 M6.5,6.5 A8,8 0 1 0 17.5,6.5</Geometry>
    <Geometry x:Key="IcoLaunch">M7,4 L20,12 L7,20 Z</Geometry>
    <Geometry x:Key="IcoKeys">M3,6 H21 V18 H3 Z M7,10 V10.1 M12,10 V10.1 M17,10 V10.1 M8,14.5 H16</Geometry>
    <Geometry x:Key="IcoGear">M10.4,2.8 H13.6 L14.2,5.4 L16.5,6.7 L19,5.9 L20.6,8.7 L18.7,10.6 V13.4 L20.6,15.3 L19,18.1 L16.5,17.3 L14.2,18.6 L13.6,21.2 H10.4 L9.8,18.6 L7.5,17.3 L5,18.1 L3.4,15.3 L5.3,13.4 V10.6 L3.4,8.7 L5,5.9 L7.5,6.7 L9.8,5.4 Z M12,9 A3,3 0 1 1 11.99,9 Z</Geometry>
    <Geometry x:Key="IcoGauge">M4,18 A9.5,9.5 0 1 1 20,18 M12,14 L16,9</Geometry>
    <Geometry x:Key="IcoUp">M12,20 V5 M6,11 L12,5 L18,11</Geometry>
    <Geometry x:Key="IcoDown">M5,9 L12,16 L19,9</Geometry>
    <Geometry x:Key="IcoGlobe">M12,3 A9,9 0 1 1 11.99,3 Z M3,12 H21 M12,3 A14,14 0 0 1 12,21 M12,3 A14,14 0 0 0 12,21</Geometry>
    <Geometry x:Key="IcoRam">M3,7 H21 V17 H3 Z M7,10 V14 M12,10 V14 M17,10 V14 M6,17 V20 M12,17 V20 M18,17 V20</Geometry>
    <Geometry x:Key="IcoDisk">M5,3 H19 V21 H5 Z M12,7 A3,3 0 1 1 11.99,7 Z M8,17 H12</Geometry>
    <Geometry x:Key="IcoCpu">M7,7 H17 V17 H7 Z M10,3 V7 M14,3 V7 M10,17 V21 M14,17 V21 M3,10 H7 M3,14 H7 M17,10 H21 M17,14 H21</Geometry>

    <Style x:Key="Ico" TargetType="Path">
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
      <Setter Property="StrokeThickness" Value="2"/>
      <Setter Property="StrokeStartLineCap" Value="Round"/>
      <Setter Property="StrokeEndLineCap" Value="Round"/>
      <Setter Property="StrokeLineJoin" Value="Round"/>
      <Setter Property="Width" Value="24"/>
      <Setter Property="Height" Value="24"/>
    </Style>

    <Style x:Key="Focus">
      <Setter Property="Control.Template"><Setter.Value><ControlTemplate><Rectangle Margin="-4" Stroke="{DynamicResource Ink}" StrokeThickness="2" RadiusX="16" RadiusY="16"/></ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="Btn" TargetType="t:Btn">
      <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
      <Setter Property="Background" Value="{DynamicResource Btn}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BtnHover}"/>
      <Setter Property="Foreground" Value="{DynamicResource BtnInk}"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="FontSize" Value="14.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="t:Btn">
            <Grid>
            <Border x:Name="halo" Background="{TemplateBinding Background}" CornerRadius="16" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False" Visibility="Collapsed"/>
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="13" Padding="{TemplateBinding Padding}">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Viewbox x:Name="ic" Width="18" Height="18" Margin="0,0,9,0"><Path Data="{TemplateBinding Icon}" Stroke="{TemplateBinding Foreground}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="24" Height="24"/></Viewbox>
                <ContentPresenter VerticalAlignment="Center" Margin="0,2,0,0"/>
              </StackPanel>
            </Border>
            <Border x:Name="shine" CornerRadius="13" IsHitTestVisible="False" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Icon" Value="{x:Null}"><Setter TargetName="ic" Property="Visibility" Value="Collapsed"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BtnCta" TargetType="t:Btn" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="{DynamicResource Cta}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Cta}"/>
      <Setter Property="Foreground" Value="{DynamicResource CtaInk}"/>
      <Setter Property="Height" Value="60"/>
      <Setter Property="Glint" Value="True"/>
      <Setter Property="Padding" Value="28,0"/>
      <Setter Property="FontSize" Value="19"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="Switch" TargetType="t:Switch">
      <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="t:Switch">
            <Grid Width="60" Height="34" Background="Transparent">
              <Border Background="{DynamicResource Off}" CornerRadius="17"/>
              <Border x:Name="live" Background="{DynamicResource On}" CornerRadius="17" Opacity="0"/>
              <Border x:Name="knob" Width="26" Height="26" Margin="4" HorizontalAlignment="Left" CornerRadius="13" Background="{DynamicResource Knob}">
                <Viewbox Width="14" Height="14"><Path x:Name="tick" Data="{StaticResource IcoCheck}" Stroke="{DynamicResource OnInk}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="24" Height="24" Opacity="0"/></Viewbox>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding State, RelativeSource={RelativeSource Self}}" Value="True"><Setter TargetName="tick" Property="Opacity" Value="1"/><Setter TargetName="tick" Property="Stroke" Value="#0B2A22"/></DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="12"/>
      <Setter Property="MinWidth" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb MinHeight="44"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="t" Background="{DynamicResource Ink}" Opacity="0.35" CornerRadius="4" Margin="2,0"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="Opacity" Value="0.7"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Ink}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource On}"/>
      <Setter Property="SelectionOpacity" Value="0.5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding Background}" BorderThickness="2" CornerRadius="13" Padding="12,0">
              <Grid>
                <TextBlock x:Name="hint" Text="{TemplateBinding Tag}" Foreground="{DynamicResource Ink2}" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" Margin="2,2,2,0"/>
                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="0,2,0,0"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Text" Value=""><Setter TargetName="hint" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Ink}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- La plantilla de Windows pinta la lista de blanco al desactivarla. -->
    <ControlTemplate x:Key="PlainList" TargetType="ListBox">
      <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"><ItemsPresenter/></ScrollViewer>
    </ControlTemplate>
    <ControlTemplate x:Key="BareList" TargetType="ListBox"><ItemsPresenter/></ControlTemplate>

    <Style x:Key="Skel" TargetType="ContentControl">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl"><Grid><Border Background="{DynamicResource Card}" CornerRadius="12"/><Border Background="{DynamicResource Shimmer}" CornerRadius="12"/></Grid></ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="BareItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- Opcion con nombre y nota -->
    <Style x:Key="LinkBtn" TargetType="t:Btn">
      <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="t:Btn"><Border Background="Transparent" Padding="2,6"><TextBlock x:Name="tx" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" TextDecorations="Underline"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="tx" Property="Foreground" Value="{DynamicResource Ink}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ChipItem" TargetType="ListBoxItem">
      <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="b" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Card}" BorderThickness="3" CornerRadius="14" Padding="12,8" Margin="0,0,8,8">
              <StackPanel>
                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Typography.NumeralAlignment="Tabular"/>
                <TextBlock x:Name="nt" Text="{Binding Note}" Foreground="{DynamicResource Ink2}" FontSize="13"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource CardHover}"/></Trigger>
              <DataTrigger Binding="{Binding Note}" Value="{x:Null}"><Setter TargetName="nt" Property="Visibility" Value="Collapsed"/></DataTrigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource On}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="NavItem" TargetType="ListBoxItem">
      <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="b" Background="Transparent" Padding="14,0" Height="44" CornerRadius="12"><ContentPresenter VerticalAlignment="Center"/></Border>
            <ControlTemplate.Triggers><DataTrigger Binding="{Binding Sub}" Value="True"><Setter TargetName="b" Property="Height" Value="29"/><Setter TargetName="b" Property="Padding" Value="34,0,14,0"/></DataTrigger></ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Check" TargetType="CheckBox">
      <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent" Height="42">
              <Border x:Name="box" Width="24" Height="24" Background="{DynamicResource Card}" CornerRadius="8" VerticalAlignment="Center">
                <Viewbox Width="14" Height="14"><Path x:Name="tick" Data="{StaticResource IcoCheck}" Stroke="{DynamicResource OnInk}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="24" Height="24" Visibility="Hidden"/></Viewbox>
              </Border>
              <ContentPresenter Margin="10,2,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="tick" Property="Visibility" Value="Visible"/><Setter TargetName="box" Property="Background" Value="{DynamicResource On}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PartCard" TargetType="ContentControl">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContentControl">
            <Border Background="{DynamicResource Card}" CornerRadius="18" Padding="18,16">
              <DockPanel>
                <Border Width="54" Height="54" CornerRadius="16" Background="{DynamicResource Rail}" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0"><Viewbox Width="28" Height="28"><Path Data="{Binding Icon}" Style="{StaticResource Ico}"/></Viewbox></Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding Main}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding Sub}" Foreground="{DynamicResource Ink2}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
              </DockPanel>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid x:Name="Shell" Background="{DynamicResource Bg}">
    <Grid x:Name="Main">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="292"/>
      </Grid.ColumnDefinitions>

      <!-- Navegacion -->
      <DockPanel Grid.Column="0" Background="{DynamicResource Rail}">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,20,16,14">
          <Viewbox Width="28" Height="42" VerticalAlignment="Center"><Canvas Width="38" Height="57"><Canvas Margin="-13,-3.5,0,0"><Canvas x:Name="LogoEars" RenderTransformOrigin="0.5,1" Width="64" Height="28"><Path Data="{StaticResource LogoEarsShape}" Fill="{DynamicResource On}"/><Path Data="{StaticResource LogoInner}" Fill="{DynamicResource Cta}"/></Canvas><Path Data="{StaticResource LogoHead}" Fill="{DynamicResource On}"/><Path Data="{StaticResource LogoFace}" Fill="{DynamicResource Rail}"/></Canvas></Canvas></Viewbox>
          <TextBlock Text="Tweakeroo" FontSize="27" FontWeight="Bold" Margin="12,3,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="22,10,16,16">
          <TextBlock x:Name="PaletteName" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <Border x:Name="PaletteZone" Background="Transparent" Height="44">
          <ListBox x:Name="Palettes" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0" Padding="0" Margin="-4,0,0,0">
            <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="ToolTip" Value="{Binding Name}"/>
                <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="ring" Width="36" Height="36" CornerRadius="18" BorderThickness="2.5" BorderBrush="Transparent" Padding="3.5" Margin="0,0,2,0" VerticalAlignment="Center">
                        <Grid Width="24" Height="24">
                          <Ellipse Fill="{Binding Base}" Stroke="{DynamicResource Ink}" StrokeThickness="1"/>
                          <Path Data="M12,1 A11,11 0 0 1 12,23 Z" Fill="{Binding Accent}"/>
                          <Ellipse Width="10" Height="10" Fill="{Binding Live}"/>
                        </Grid>
                      </Border>
                      <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource Ink}"/></Trigger></ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
          </ListBox>
          </Border>
          <t:Btn x:Name="OpenSettings" Style="{StaticResource Btn}" Icon="{StaticResource IcoGear}" Content="Ajustes" Height="38" HorizontalAlignment="Left" Margin="0,8,0,0"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
          <Grid Margin="12,0">
            <Border x:Name="NavMark" Visibility="Hidden" Height="44" CornerRadius="12" Background="{DynamicResource Card}" VerticalAlignment="Top"/>
            <ListBox x:Name="Circuits" Template="{StaticResource BareList}" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel>
                    <Viewbox Width="{Binding IconSize}" Height="{Binding IconSize}" DockPanel.Dock="Left" Margin="0,0,13,0"><Path Data="{Binding Icon}" Style="{StaticResource Ico}"/></Viewbox>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" FontSize="13" Margin="8,2,0,0" Foreground="{DynamicResource Ink2}" Typography.NumeralAlignment="Tabular"/>
                    <Viewbox DockPanel.Dock="Right" Width="16" Height="16" Visibility="{Binding HasSubs, Converter={StaticResource Vis}}"><Path x:Name="Chevron" Data="M5,9 L12,16 L19,9" Style="{StaticResource Ico}" StrokeThickness="3"/></Viewbox>
                    <TextBlock Text="{Binding Name}" FontSize="{Binding Size}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel x:Name="SkelNav" Visibility="Collapsed">
              <ContentControl Style="{StaticResource Skel}" Width="150" Height="24" Margin="14,10"/>
              <ContentControl Style="{StaticResource Skel}" Width="120" Height="24" Margin="14,10"/>
              <ContentControl Style="{StaticResource Skel}" Width="134" Height="24" Margin="14,10"/>
              <ContentControl Style="{StaticResource Skel}" Width="126" Height="24" Margin="14,10"/>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </DockPanel>

      <!-- Mi PC -->
      <ScrollViewer x:Name="PcPage" Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="Hidden">
        <StackPanel Margin="28,24,20,110">
          <TextBlock x:Name="PcTitle" Text="Prepara tu PC para jugar" FontSize="32" FontWeight="Bold" TextWrapping="Wrap"/>
          <TextBlock x:Name="PcText" Foreground="{DynamicResource Ink2}" FontSize="15" TextWrapping="Wrap" Margin="0,6,0,18" MaxWidth="560" HorizontalAlignment="Left"/>
          <WrapPanel Margin="0,0,0,24">
            <t:Btn x:Name="Scan" Style="{StaticResource BtnCta}" Icon="{StaticResource IcoScan}" Content="Escanear PC" Margin="0,0,10,10"/>
            <t:Btn x:Name="Rescan" Style="{StaticResource Btn}" Icon="{StaticResource IcoScan}" Content="Volver a escanear" Height="60" Margin="0,0,10,10" Visibility="Collapsed"/>
            <t:Btn x:Name="ShowRec" Style="{StaticResource Btn}" Icon="{StaticResource IcoEye}" Content="Ver lista" Height="60" Margin="0,0,10,10" Visibility="Collapsed"/>
          </WrapPanel>
          <Grid x:Name="Meter" Height="16" Margin="0,0,0,8">
            <Border Background="{DynamicResource Rail}" CornerRadius="8"/>
            <Border x:Name="MeterFill" Background="{DynamicResource On}" CornerRadius="8" Visibility="Hidden"/>
          </Grid>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
            <TextBlock x:Name="TotalOn" FontSize="17" FontWeight="Bold" Typography.NumeralAlignment="Tabular"/>
            <TextBlock x:Name="TotalText" FontSize="15" Foreground="{DynamicResource Ink2}" Margin="6,2,0,0"/>
          </StackPanel>
          <ItemsControl x:Name="Parts" Focusable="False" Margin="0,0,-10,0">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate><ContentControl Style="{StaticResource PartCard}" Margin="0,0,10,10"/></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl x:Name="Notes" Focusable="False" Margin="0,14,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,0,10,12">
                  <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource On}" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,0,14,0"><Viewbox Width="14" Height="14"><Path Data="{StaticResource IcoCheck}" Stroke="{DynamicResource OnInk}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="24" Height="24"/></Viewbox></Border>
                  <TextBlock Text="{Binding}" FontSize="15" TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <WrapPanel Margin="0,16,0,0">
            <t:Btn x:Name="AllOn" Style="{StaticResource Btn}" Icon="{StaticResource IcoPower}" Content="Activar todo" ToolTip="Activa todos los tweaks menos los de riesgo" Margin="0,0,10,10"/>
            <t:Btn x:Name="AllOff" Style="{StaticResource Btn}" Icon="{StaticResource IcoUndo}" Content="Deshacer todo" ToolTip="Quita lo que activó Tweakeroo. Lo que ya estaba así antes no se toca" Margin="0,0,10,10"/>
          </WrapPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- Jugar -->
      <ScrollViewer x:Name="StretchPage" Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="Collapsed">
        <StackPanel Margin="28,24,28,110">
          <TextBlock Text="Jugar" FontSize="32" FontWeight="Bold" TextWrapping="Wrap"/>
          <TextBlock Text="Abre Fortnite con la resolución elegida. Al cerrarlo, la pantalla y la configuración se restauran." Foreground="{DynamicResource Ink2}" FontSize="15" TextWrapping="Wrap" Margin="0,6,0,18" MaxWidth="580" HorizontalAlignment="Left"/>
          <WrapPanel Margin="0,0,0,12">
            <t:Btn x:Name="Play" Style="{StaticResource BtnCta}" Icon="{StaticResource IcoGame}" Content="Abrir Fortnite" Margin="0,0,14,10"/>
            <t:Btn x:Name="Back" Style="{StaticResource Btn}" Icon="{StaticResource IcoUndo}" Content="Restaurar resolución" Height="60" Margin="0,0,10,10" Visibility="Collapsed"/>
          </WrapPanel>
          <UniformGrid Rows="1" Margin="0,0,-8,24">
            <Border Background="{DynamicResource Rail}" CornerRadius="18" Padding="18,12" Margin="0,0,8,0"><StackPanel><TextBlock Text="FPS estimados" FontSize="13.5" Foreground="{DynamicResource Ink2}"/><TextBlock x:Name="PlayEst" Text="…" FontSize="24" FontWeight="Bold"/></StackPanel></Border>
            <Border Background="{DynamicResource Rail}" CornerRadius="18" Padding="18,12" Margin="0,0,8,0"><StackPanel><TextBlock Text="Última partida" FontSize="13.5" Foreground="{DynamicResource Ink2}"/><TextBlock x:Name="PlayLast" Text="…" FontSize="24" FontWeight="Bold"/></StackPanel></Border>
            <Border Background="{DynamicResource Rail}" CornerRadius="18" Padding="18,12" Margin="0,0,8,0"><StackPanel><TextBlock Text="Memoria libre" FontSize="13.5" Foreground="{DynamicResource Ink2}"/><TextBlock x:Name="PlayRam" Text="…" FontSize="24" FontWeight="Bold"/></StackPanel></Border>
          </UniformGrid>
          <TextBlock Text="Resolución" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
          <DockPanel>
            <StackPanel DockPanel.Dock="Left" Width="224" Margin="0,0,18,0">
              <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,10,0">
                  <Border Width="106" Height="150" CornerRadius="14" RenderOptions.BitmapScalingMode="HighQuality"><Border.Background><ImageBrush x:Name="FigureNormal" Stretch="UniformToFill"/></Border.Background></Border>
                  <TextBlock Text="Normal" FontSize="13" HorizontalAlignment="Center" Foreground="{DynamicResource Ink2}" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel>
                  <Border Width="106" Height="150" CornerRadius="14" RenderOptions.BitmapScalingMode="HighQuality"><Border.Background><ImageBrush x:Name="FigureWide" Stretch="UniformToFill"><ImageBrush.RelativeTransform><ScaleTransform x:Name="FigureScale" CenterX="0.5"/></ImageBrush.RelativeTransform></ImageBrush></Border.Background></Border>
                  <TextBlock Text="Stretched" FontSize="13" HorizontalAlignment="Center" Foreground="{DynamicResource Ink2}" Margin="0,6,0,0"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>
            <StackPanel>
              <t:Btn x:Name="ResOpen" Style="{StaticResource Btn}" Icon="{StaticResource IcoDown}" Height="52" FontSize="16" HorizontalAlignment="Left" MinWidth="290" AutomationProperties.Name="Elegir resolución"/>
              <TextBlock x:Name="StretchInfo" FontSize="15" TextWrapping="Wrap" Margin="2,12,0,0"/>
            </StackPanel>
          </DockPanel>
          <Border x:Name="ResPanel" Background="{DynamicResource Rail}" CornerRadius="18" Padding="14,14,6,6" Margin="0,14,0,0" Visibility="Collapsed">
            <StackPanel>
              <ListBox x:Name="Resolutions" Template="{StaticResource BareList}" ItemContainerStyle="{StaticResource ChipItem}" Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.Name="Resolución">
                <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ListBox.ItemsPanel>
              </ListBox>
              <StackPanel Margin="4,8,8,10">
                <TextBlock Text="Personalizada" FontSize="16" FontWeight="Bold"/>
                <TextBlock x:Name="CustomHint" Foreground="{DynamicResource Ink2}" TextWrapping="Wrap" Margin="0,2,0,8"/>
                <WrapPanel x:Name="CustomRow">
                  <TextBox x:Name="CustomW" Style="{StaticResource Field}" Background="{DynamicResource Card}" Width="110" Tag="Ancho" MaxLength="4" AutomationProperties.Name="Ancho"/>
                  <TextBlock Text="×" FontSize="18" VerticalAlignment="Center" Margin="10,0"/>
                  <TextBox x:Name="CustomH" Style="{StaticResource Field}" Background="{DynamicResource Card}" Width="110" Tag="Alto" MaxLength="4" AutomationProperties.Name="Alto"/>
                  <t:Btn x:Name="CustomGo" Style="{StaticResource Btn}" Content="Usar esta" Margin="10,0,0,0"/>
                </WrapPanel>
              </StackPanel>
            </StackPanel>
          </Border>
          <TextBlock Text="Límite de FPS" FontSize="20" FontWeight="Bold" Margin="0,24,0,10"/>
          <ListBox x:Name="Limits" Template="{StaticResource BareList}" ItemContainerStyle="{StaticResource ChipItem}" Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.Name="Límite de FPS">
            <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Margin="0,0,-8,0"/></ItemsPanelTemplate></ListBox.ItemsPanel>
          </ListBox>
          <CheckBox x:Name="Minimize" Style="{StaticResource Check}" Content="Minimizar Tweakeroo mientras juegas" FontSize="15" Margin="0,8,0,0"/>
          <TextBlock Text="Programas con más uso de memoria" FontSize="20" FontWeight="Bold" Margin="0,20,0,2"/>
          <TextBlock Text="Cerrar los que no se usen libera memoria antes de jugar." Foreground="{DynamicResource Ink2}" Margin="0,0,0,10"/>
          <ItemsControl x:Name="Heavy" Focusable="False">
            <ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource Card}" CornerRadius="12" Padding="18,10" Margin="0,0,0,4"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontWeight="Bold" Typography.NumeralAlignment="Tabular"/><TextBlock Text="{Binding Key}"/></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="PlayNote" Foreground="{DynamicResource Ink2}" TextWrapping="Wrap" Margin="0,20,0,0" MaxWidth="620" HorizontalAlignment="Left"/>
        </StackPanel>
      </ScrollViewer>

      <!-- Conexion -->
      <ScrollViewer x:Name="NetPage" Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="Collapsed">
        <StackPanel Margin="28,24,28,110">
          <TextBlock Text="Conexión" FontSize="32" FontWeight="Bold"/>
          <TextBlock Text="Mide el ping, los tirones y los paquetes perdidos, y dice dónde está el problema: tu red, el proveedor o la ruta hasta Epic." Foreground="{DynamicResource Ink2}" FontSize="15" TextWrapping="Wrap" Margin="0,6,0,16" MaxWidth="600" HorizontalAlignment="Left"/>
          <WrapPanel Margin="0,0,0,12"><t:Btn x:Name="NetRun" Style="{StaticResource BtnCta}" Icon="{StaticResource IcoGauge}" Content="Medir conexión" Margin="0,0,10,10"/><t:Btn x:Name="NetTweaks" Style="{StaticResource Btn}" Icon="{StaticResource IcoBolt}" Content="Tweaks de red" Height="60" Margin="0,0,10,10"/></WrapPanel>
          <ItemsControl x:Name="NetTiles" Focusable="False">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Margin="0,0,-8,0"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource Rail}" CornerRadius="18" Padding="18,12" Margin="0,0,8,0"><StackPanel><TextBlock Text="{Binding Label}" FontSize="13.5" Foreground="{DynamicResource Ink2}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Main}" FontSize="24" FontWeight="Bold" Typography.NumeralAlignment="Tabular"/><TextBlock Text="{Binding Sub}" FontSize="13" Foreground="{DynamicResource Ink2}" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="NetVerdict" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,14,0,0" MaxWidth="640" HorizontalAlignment="Left"/>
          <TextBlock x:Name="NetBefore" Foreground="{DynamicResource Ink2}" TextWrapping="Wrap" Margin="0,4,0,0"/>
          <TextBlock Text="Velocidad" FontSize="20" FontWeight="Bold" Margin="0,22,0,10"/>
          <ItemsControl x:Name="SpeedTiles" Focusable="False">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Margin="0,0,-8,0"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource Rail}" CornerRadius="18" Padding="18,12" Margin="0,0,8,0"><StackPanel><TextBlock Text="{Binding Label}" FontSize="13.5" Foreground="{DynamicResource Ink2}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Main}" FontSize="24" FontWeight="Bold" Typography.NumeralAlignment="Tabular"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="SpeedVerdict" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,0" MaxWidth="640" HorizontalAlignment="Left"/>
          <TextBlock x:Name="SpeedBefore" Foreground="{DynamicResource Ink2}" TextWrapping="Wrap" Margin="0,4,0,10"/>
          <WrapPanel><t:Btn x:Name="SpeedRun" Style="{StaticResource Btn}" Icon="{StaticResource IcoSave}" Content="Medir velocidad" Margin="0,0,14,0"/><TextBlock Text="Dura unos 15 segundos y puede usar hasta 750 MB. Usa los servidores de Cloudflare." Foreground="{DynamicResource Ink2}" VerticalAlignment="Center"/></WrapPanel>
          <StackPanel x:Name="NetWifi">
            <TextBlock Text="Mientras se juega" FontSize="20" FontWeight="Bold" Margin="0,22,0,10"/>
            <Border Background="{DynamicResource Rail}" CornerRadius="16" Padding="18,12"><DockPanel><CheckBox x:Name="NetSteady" DockPanel.Dock="Right" Style="{StaticResource Check}" AutomationProperties.Name="Wi-Fi estable" Margin="16,0,0,0" VerticalAlignment="Center"/><StackPanel VerticalAlignment="Center"><TextBlock Text="Wi-Fi estable" FontSize="16" FontWeight="Bold"/><TextBlock Text="Con Fortnite abierto, Windows deja de buscar otras redes, que es una causa de tirones. Al cerrarlo vuelve a lo normal. Algunas tarjetas no lo respetan." Foreground="{DynamicResource Ink2}" TextWrapping="Wrap" Margin="0,2,0,0"/><TextBlock x:Name="NetState" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel></DockPanel></Border>
          </StackPanel>
          <TextBlock Text="Estado de la red" FontSize="20" FontWeight="Bold" Margin="0,22,0,10"/>
          <ItemsControl x:Name="NetChecks" Focusable="False"/>
          <TextBlock Text="Tweakeroo no pasa el tráfico por otros servidores, como hace ExitLag, así que no acorta la distancia hasta Epic. Al medir hace ping al router, a 1.1.1.1 y a los servidores de medición de Epic, y la velocidad se mide con Cloudflare." Foreground="{DynamicResource Ink2}" TextWrapping="Wrap" Margin="0,14,0,0" MaxWidth="640" HorizontalAlignment="Left"/>
        </StackPanel>
      </ScrollViewer>

      <!-- Macros -->
      <ScrollViewer x:Name="MacroPage" Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="Collapsed">
        <StackPanel Margin="28,24,28,110">
          <TextBlock Text="Macros" FontSize="32" FontWeight="Bold"/>
          <TextBlock Text="Macros de edición para freebuild. Solo funcionan en Creativo, con Fortnite en primer plano y Tweakeroo abierto. En cualquier otro modo quedan apagadas." Foreground="{DynamicResource Ink2}" FontSize="15" TextWrapping="Wrap" Margin="0,6,0,16" MaxWidth="600" HorizontalAlignment="Left"/>
          <Border Background="{DynamicResource Rail}" CornerRadius="18" Padding="18,14" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Text="Uso bajo tu propio riesgo" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Danger}"/>
              <TextBlock Text="Epic prohíbe las macros en torneos y usarlas, también en Creativo, puede llevar a sanciones en la cuenta. Tweakeroo no las oculta ni evita la detección." TextWrapping="Wrap" Margin="0,4,0,4"/>
              <CheckBox x:Name="MacroAccept" Style="{StaticResource Check}" Content="Acepto el riesgo" FontSize="15"/>
            </StackPanel>
          </Border>
          <StackPanel x:Name="MacroBody">
            <TextBlock x:Name="MacroState" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <ItemsControl x:Name="MacroRows" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource Rail}" CornerRadius="16" Padding="18,12" Margin="0,0,0,8">
                    <DockPanel>
                      <CheckBox DockPanel.Dock="Right" Style="{StaticResource Check}" IsChecked="{Binding On, Mode=TwoWay}" AutomationProperties.Name="{Binding Name}" VerticalAlignment="Center"/>
                      <t:Btn DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="{Binding KeyText}" MinWidth="150" Margin="16,0,18,0" VerticalAlignment="Center"/>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Desc}" Foreground="{DynamicResource Ink2}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Teclas en Fortnite" FontSize="20" FontWeight="Bold" Margin="0,18,0,2"/>
            <TextBlock Text="Se leen solas de Fortnite. Si se ponen a mano, deben ser las mismas que en el juego, también confirmar al soltar: si no coinciden, la macro puede quedarse dentro de la edición." Foreground="{DynamicResource Ink2}" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <WrapPanel>
              <StackPanel Margin="0,0,14,8"><TextBlock Text="Editar" Foreground="{DynamicResource Ink2}" Margin="2,0,0,4"/><t:Btn x:Name="KeyEdit" Style="{StaticResource Btn}" MinWidth="150"/></StackPanel>
              <StackPanel Margin="0,0,14,8"><TextBlock Text="Seleccionar" Foreground="{DynamicResource Ink2}" Margin="2,0,0,4"/><t:Btn x:Name="KeySelect" Style="{StaticResource Btn}" MinWidth="150"/></StackPanel>
              <StackPanel Margin="0,0,0,8"><TextBlock Text="Resetear" Foreground="{DynamicResource Ink2}" Margin="2,0,0,4"/><t:Btn x:Name="KeyReset" Style="{StaticResource Btn}" MinWidth="150"/></StackPanel>
            </WrapPanel>
            <CheckBox x:Name="MacroAuto" Style="{StaticResource Check}" Content="Usar las teclas que hay en Fortnite" FontSize="15"/>
            <CheckBox x:Name="MacroConfirm" Style="{StaticResource Check}" Content="Confirmar edición al soltar está activado en Fortnite" FontSize="15"/>
            <TextBlock Text="Al pulsar la tecla de la macro" FontSize="20" FontWeight="Bold" Margin="0,14,0,2"/>
            <TextBlock Text="Un toque manda toda la secuencia. Mantener deja arrastrar para elegir varias casillas y sigue al soltar." Foreground="{DynamicResource Ink2}" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <ListBox x:Name="MacroHold" Template="{StaticResource BareList}" ItemContainerStyle="{StaticResource ChipItem}" Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.Name="Al pulsar la tecla de la macro"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="2" Margin="0,0,-8,0"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
            <TextBlock Text="Pausa antes de la segunda acción" FontSize="20" FontWeight="Bold" Margin="0,14,0,2"/>
            <TextBlock Text="Si la segunda edición no sale, sube este valor. Depende del ping y de los FPS." Foreground="{DynamicResource Ink2}" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <ListBox x:Name="MacroGap" Template="{StaticResource BareList}" ItemContainerStyle="{StaticResource ChipItem}" Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.Name="Pausa antes de la segunda acción"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="4" Margin="0,0,-8,0"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
            <TextBlock Text="Pausa entre acciones" FontSize="20" FontWeight="Bold" Margin="0,14,0,10"/>
            <ListBox x:Name="MacroDelay" Template="{StaticResource BareList}" ItemContainerStyle="{StaticResource ChipItem}" Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.Name="Pausa entre acciones">
              <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Margin="0,0,-8,0"/></ItemsPanelTemplate></ListBox.ItemsPanel>
            </ListBox>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- Ajustes -->
      <ScrollViewer x:Name="SettingsPage" Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="Collapsed">
        <StackPanel Margin="28,24,28,110">
          <TextBlock Text="Ajustes" FontSize="32" FontWeight="Bold" Margin="0,0,0,16"/>
            <TextBlock Text="General" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
            <Border Background="{DynamicResource Rail}" CornerRadius="16" Padding="18,12" Margin="0,0,0,8"><DockPanel><CheckBox x:Name="SetBoot" DockPanel.Dock="Right" Style="{StaticResource Check}" AutomationProperties.Name="Abrir al encender el PC" Margin="16,0,0,0" VerticalAlignment="Center"/><StackPanel VerticalAlignment="Center"><TextBlock Text="Abrir al encender el PC" FontSize="16" FontWeight="Bold"/><TextBlock Text="Solo con la app instalada. Usa una tarea de Windows, que se quita al apagar la opción." Foreground="{DynamicResource Ink2}" TextWrapping="Wrap" Margin="0,2,0,0"/></StackPanel></DockPanel></Border>
            <Border Background="{DynamicResource Rail}" CornerRadius="16" Padding="18,12" Margin="0,0,0,8"><DockPanel><CheckBox x:Name="SetMin" DockPanel.Dock="Right" Style="{StaticResource Check}" AutomationProperties.Name="Empezar minimizado" Margin="16,0,0,0" VerticalAlignment="Center"/><StackPanel VerticalAlignment="Center"><TextBlock Text="Empezar minimizado" FontSize="16" FontWeight="Bold"/><TextBlock Text="Solo cuando se abre con Windows." Foreground="{DynamicResource Ink2}" TextWrapping="Wrap" Margin="0,2,0,0"/></StackPanel></DockPanel></Border>
            <Border Background="{DynamicResource Rail}" CornerRadius="16" Padding="18,12" Margin="0,0,0,8"><DockPanel><CheckBox x:Name="SetTray" DockPanel.Dock="Right" Style="{StaticResource Check}" AutomationProperties.Name="Al cerrar, quedarse junto al reloj" Margin="16,0,0,0" VerticalAlignment="Center"/><StackPanel VerticalAlignment="Center"><TextBlock Text="Al cerrar, quedarse junto al reloj" FontSize="16" FontWeight="Bold"/><TextBlock Text="Las macros y la resolución siguen funcionando. Para salir, clic derecho en el icono." Foreground="{DynamicResource Ink2}" TextWrapping="Wrap" Margin="0,2,0,0"/></StackPanel></DockPanel></Border>
            <Border Background="{DynamicResource Rail}" CornerRadius="16" Padding="18,12" Margin="0,0,0,8"><StackPanel><TextBlock Text="Idioma" FontSize="16" FontWeight="Bold"/><TextBlock Text="La app se reinicia al cambiarlo." Foreground="{DynamicResource Ink2}" TextWrapping="Wrap" Margin="0,2,0,0"/><ListBox x:Name="SetLang" Template="{StaticResource BareList}" ItemContainerStyle="{StaticResource ChipItem}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,8,0,0" AutomationProperties.Name="Idioma"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="2" Margin="0,0,-8,-8"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox></StackPanel></Border>
            <Border Background="{DynamicResource Rail}" CornerRadius="16" Padding="18,12" Margin="0,0,0,8"><StackPanel><TextBlock Text="Sección con la que se abre" FontSize="16" FontWeight="Bold"/><ListBox x:Name="SetPage" Template="{StaticResource BareList}" ItemContainerStyle="{StaticResource ChipItem}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,8,0,0" AutomationProperties.Name="Sección con la que se abre"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="6" Margin="0,0,-8,-8"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox></StackPanel></Border>
            <TextBlock Text="Apariencia" FontSize="20" FontWeight="Bold" Margin="0,18,0,10"/>
            <Border Background="{DynamicResource Rail}" CornerRadius="16" Padding="18,12" Margin="0,0,0,8"><StackPanel><TextBlock Text="Animaciones" FontSize="16" FontWeight="Bold"/><ListBox x:Name="SetMotion" Template="{StaticResource BareList}" ItemContainerStyle="{StaticResource ChipItem}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,8,0,0" AutomationProperties.Name="Animaciones"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="3" Margin="0,0,-8,-8"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox></StackPanel></Border>
            <TextBlock Text="Fortnite" FontSize="20" FontWeight="Bold" Margin="0,18,0,10"/>
            <StackPanel x:Name="SetGame">
            <Border Background="{DynamicResource Rail}" CornerRadius="16" Padding="18,12" Margin="0,0,0,8"><DockPanel><CheckBox x:Name="SetMinimize" DockPanel.Dock="Right" Style="{StaticResource Check}" AutomationProperties.Name="Minimizar Tweakeroo mientras juegas" Margin="16,0,0,0" VerticalAlignment="Center"/><StackPanel VerticalAlignment="Center"><TextBlock Text="Minimizar Tweakeroo mientras juegas" FontSize="16" FontWeight="Bold"/></StackPanel></DockPanel></Border>
            <Border Background="{DynamicResource Rail}" CornerRadius="16" Padding="18,12" Margin="0,0,0,8"><StackPanel><TextBlock Text="Límite de FPS" FontSize="16" FontWeight="Bold"/><ListBox x:Name="SetLimits" Template="{StaticResource BareList}" ItemContainerStyle="{StaticResource ChipItem}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,8,0,0" AutomationProperties.Name="Límite de FPS"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="3" Margin="0,0,-8,-8"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox></StackPanel></Border>
            </StackPanel>
            <Border Background="{DynamicResource Rail}" CornerRadius="16" Padding="18,12" Margin="0,0,0,8"><StackPanel><TextBlock Text="Tiempo para confirmar una resolución nueva" FontSize="16" FontWeight="Bold"/><ListBox x:Name="SetConfirm" Template="{StaticResource BareList}" ItemContainerStyle="{StaticResource ChipItem}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,8,0,0" AutomationProperties.Name="Tiempo para confirmar una resolución nueva"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="3" Margin="0,0,-8,-8"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox></StackPanel></Border>
            <TextBlock Text="Actualizaciones" FontSize="20" FontWeight="Bold" Margin="0,18,0,10"/>
