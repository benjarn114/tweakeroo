            <ItemsControl x:Name="Plan" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource Rail}" CornerRadius="18" Padding="18,14" Margin="0,0,0,8">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Left" Text="{Binding N}" FontSize="28" FontWeight="Bold" Width="46" VerticalAlignment="Center" Foreground="{DynamicResource Ink2}" Typography.NumeralAlignment="Tabular"/>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="16.5" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Text}" Foreground="{DynamicResource Ink2}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- Lista -->      <DockPanel x:Name="ListPage" Grid.Column="1" Visibility="Collapsed">
