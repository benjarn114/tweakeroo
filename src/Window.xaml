            <Label Style="{StaticResource Head}" Content="Ayuda" Margin="0,18,0,10"/>
            <WrapPanel><t:Btn x:Name="LinkGit" Style="{StaticResource Btn}" Content="GitHub" Margin="0,0,10,10"/><t:Btn x:Name="LinkBug" Style="{StaticResource Btn}" Content="Informar de un fallo" Margin="0,0,10,10"/><t:Btn x:Name="CopySupport" Style="{StaticResource Btn}" Content="Copiar datos para soporte" Margin="0,0,10,10"/><t:Btn x:Name="ShowTerms" Style="{StaticResource Btn}" Content="Términos y privacidad" Margin="0,0,10,10"/><t:Btn x:Name="ResetSet" Style="{StaticResource Btn}" Margin="0,0,10,10"/></WrapPanel>
