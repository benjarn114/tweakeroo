              <t:Btn x:Name="CatOff" Style="{StaticResource Btn}" Icon="{StaticResource IcoUndo}" Content="Deshacer" Margin="8,0,0,0" ToolTip="Quita lo que activó Tweakeroo en esta lista"/>
            </StackPanel>
            <TextBlock x:Name="CatTitle" FontSize="28" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
          <DockPanel Margin="0,14,0,0">
            <CheckBox x:Name="OnlyOff" DockPanel.Dock="Right" Style="{StaticResource Check}" Content="Solo sin activar" VerticalAlignment="Center" Margin="16,0,0,0"/>
