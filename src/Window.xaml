    <Geometry x:Key="IcoNet">M2,9 A14,14 0 0 1 22,9 M5.5,13 A9,9 0 0 1 18.5,13 M9,16.5 A4.5,4.5 0 0 1 15,16.5 M12,20 V20.1</Geometry>
    <Geometry x:Key="IcoLayers">M12,3 L22,8 L12,13 L2,8 Z M2,13 L12,18 L22,13</Geometry>
    <Geometry x:Key="IcoServer">M3,4 H21 V10 H3 Z M3,14 H21 V20 H3 Z M7,7 V7.1 M7,17 V17.1</Geometry>
    <Geometry x:Key="IcoClock">M12,3 A9,9 0 1 1 11.99,3 Z M12,7 V12 L15.5,14</Geometry>
    <Geometry x:Key="IcoBell">M6,16 V11 A6,6 0 0 1 18,11 V16 L20,18 H4 Z M10,21 H14</Geometry>
    <Geometry x:Key="IcoTag">M3,12 V3 H12 L21,12 L12,21 Z M7.5,7.5 V7.6</Geometry>
    <Geometry x:Key="IcoSearch">M10.5,4 A6.5,6.5 0 1 1 10.49,4 Z M15.5,15.5 L21,21</Geometry>
    <Geometry x:Key="IcoEye">M2,12 C6,5 18,5 22,12 C18,19 6,19 2,12 Z M12,9.5 A2.5,2.5 0 1 1 11.99,9.5 Z</Geometry>
    <Geometry x:Key="IcoWindow">M3,4 H21 V20 H3 Z M3,9 H21</Geometry>
    <Geometry x:Key="IcoUndo">M8,5 L4,9 L8,13 M4,9 H14 A5.5,5.5 0 0 1 14,20 H9</Geometry>
    <Geometry x:Key="IcoSave">M12,4 V15 M7,10.5 L12,15 L17,10.5 M4,20 H20</Geometry>
    <Geometry x:Key="IcoTrash">M4,7 H20 M9,7 V4 H15 V7 M6,7 L7,20 H17 L18,7</Geometry>
    <Geometry x:Key="IcoScan">M4,8 V4 H8 M16,4 H20 V8 M20,16 V20 H16 M8,20 H4 V16 M3,12 H21</Geometry>
    <Geometry x:Key="LogoEarsShape">M20,4 C27,6 30,16 29.5,27 L21,30 C14,22 13,10 20,4 Z M44,4 C37,6 34,16 34.5,27 L43,30 C50,22 51,10 44,4 Z</Geometry>
    <Geometry x:Key="LogoInner">M21.5,10 C25,14 26,20 25.6,25.5 L22,27 C18.5,21 18.5,14 21.5,10 Z M42.5,10 C39,14 38,20 38.4,25.5 L42,27 C45.5,21 45.5,14 42.5,10 Z</Geometry>
    <Geometry x:Key="LogoHead">M32,24 C43,24 50,31 49,40 C48,48 41,52 38,58 C36.5,61 27.5,61 26,58 C23,52 16,48 15,40 C14,31 21,24 32,24 Z</Geometry>
    <Geometry x:Key="LogoFace">M24,37 A3,3 0 1 1 23.99,37 Z M40,37 A3,3 0 1 1 39.99,37 Z M27.5,51 H36.5 L32,56 Z</Geometry>
    <Geometry x:Key="IcoCheck">M4,12.5 L9.5,18 L20,6.5</Geometry>
    <Geometry x:Key="IcoPower">M12,3 V11 M6.5,6.5 A8,8 0 1 0 17.5,6.5</Geometry>
    <Geometry x:Key="IcoLaunch">M7,4 L20,12 L7,20 Z</Geometry>
    <Geometry x:Key="IcoKeys">M3,6 H21 V18 H3 Z M7,10 V10.1 M12,10 V10.1 M17,10 V10.1 M8,14.5 H16</Geometry>
    <Geometry x:Key="IcoWide">M2,12 H22 M6,8 L2,12 L6,16 M18,8 L22,12 L18,16 M12,5 V19</Geometry>
    <Geometry x:Key="IcoDrop">M12,3 C16,8 19,11.5 19,15 A7,7 0 0 1 5,15 C5,11.5 8,8 12,3 Z M9,15.5 A3,3 0 0 0 12,18.5</Geometry>
    <Geometry x:Key="IcoGear">M10.4,2.8 H13.6 L14.2,5.4 L16.5,6.7 L19,5.9 L20.6,8.7 L18.7,10.6 V13.4 L20.6,15.3 L19,18.1 L16.5,17.3 L14.2,18.6 L13.6,21.2 H10.4 L9.8,18.6 L7.5,17.3 L5,18.1 L3.4,15.3 L5.3,13.4 V10.6 L3.4,8.7 L5,5.9 L7.5,6.7 L9.8,5.4 Z M12,9 A3,3 0 1 1 11.99,9 Z</Geometry>
    <Geometry x:Key="IcoGauge">M4,18 A9.5,9.5 0 1 1 20,18 M12,14 L16,9</Geometry>
    <Geometry x:Key="IcoUp">M12,20 V5 M6,11 L12,5 L18,11</Geometry>
    <Geometry x:Key="IcoDown">M5,9 L12,16 L19,9</Geometry>
    <Geometry x:Key="IcoGlobe">M12,3 A9,9 0 1 1 11.99,3 Z M3,12 H21 M12,3 A14,14 0 0 1 12,21 M12,3 A14,14 0 0 0 12,21</Geometry>
    <Geometry x:Key="IcoRam">M3,7 H21 V17 H3 Z M7,10 V14 M12,10 V14 M17,10 V14 M6,17 V20 M12,17 V20 M18,17 V20</Geometry>
    <Geometry x:Key="IcoDisk">M5,3 H19 V21 H5 Z M12,7 A3,3 0 1 1 11.99,7 Z M8,17 H12</Geometry>
    <!-- Music: hand-drawn, 1.6 stroke -->
    <Geometry x:Key="IcoNight">M15.5,3.2 C11.9,3.8 9.6,7.3 10.5,10.8 C11.3,14 14.8,15.9 17.9,15 C16.5,17.7 13.3,19.1 10.3,18.2 C6.6,17.3 4.5,13.1 5.6,9.4 C6.5,6.1 10,3 15.5,3.2 Z M18.6,5.3 L19,6.4 L20.1,6.7 L19,7.1 L18.7,8.2 L18.3,7.1 L17.2,6.7 L18.3,6.4 Z</Geometry>
    <Geometry x:Key="IcoArcade">M4.2,9.1 C4,7.5 5.1,6.4 6.6,6.3 L17.5,6.1 C19,6.1 20,7.2 19.9,8.7 L19.6,15.3 C19.5,16.7 18.4,17.7 17,17.7 L6.7,17.8 C5.3,17.8 4.3,16.8 4.2,15.5 Z M7.6,11.9 H10.7 M9.1,10.4 V13.5 M15.2,11.1 H15.3 M16.9,12.8 H17</Geometry>
    <Geometry x:Key="IcoRain">M6.8,13.6 C4.7,13.5 3.4,12.1 3.5,10.4 C3.6,8.6 5.1,7.4 6.8,7.6 C7.3,5.2 9.4,3.6 11.8,3.8 C14.1,4 15.8,5.7 16,7.8 C17.9,7.6 19.6,8.9 19.6,10.7 C19.6,12.3 18.3,13.6 16.5,13.6 Z M8.2,16.2 L7.3,18.6 M12.3,16.4 L11.5,19 M16.2,16.1 L15.3,18.6</Geometry>
    <Geometry x:Key="IcoMute">M4.3,9.6 L7.4,9.5 L11.8,5.8 L12,18.4 L7.5,14.8 L4.3,14.9 Z M15.4,9.4 L19.9,14.5 M19.8,9.5 L15.5,14.5</Geometry>
    <Geometry x:Key="IcoCpu">M7,7 H17 V17 H7 Z M10,3 V7 M14,3 V7 M10,17 V21 M14,17 V21 M3,10 H7 M3,14 H7 M17,10 H21 M17,14 H21</Geometry>

    <Style x:Key="Ico" TargetType="Path">
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
      <Setter Property="StrokeThickness" Value="2"/>
      <Setter Property="StrokeStartLineCap" Value="Round"/>
      <Setter Property="StrokeEndLineCap" Value="Round"/>
      <Setter Property="StrokeLineJoin" Value="Round"/>
      <Setter Property="Width" Value="24"/>
      <Setter Property="Height" Value="24"/>
    </Style>

    <Style x:Key="Focus">
      <Setter Property="Control.Template"><Setter.Value><ControlTemplate><Rectangle Margin="-4" Stroke="{DynamicResource Ink}" StrokeThickness="2" RadiusX="16" RadiusY="16"/></ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="Btn" TargetType="t:Btn">
      <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
      <!-- Secondary: outline only, so it never competes with the main button or blends with cards -->
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="FontSize" Value="14.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="t:Btn">
            <Grid>
            <Border x:Name="halo" Background="{TemplateBinding Background}" CornerRadius="13" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False" Visibility="Collapsed"/>
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Viewbox x:Name="ic" Width="18" Height="18" Margin="0,0,9,0"><Path Data="{TemplateBinding Icon}" Stroke="{TemplateBinding Foreground}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="24" Height="24"/></Viewbox>
                <ContentPresenter VerticalAlignment="Center" Margin="0,2,0,0"/>
              </StackPanel>
            </Border>
            <Border x:Name="shine" CornerRadius="10" IsHitTestVisible="False" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Icon" Value="{x:Null}"><Setter TargetName="ic" Property="Visibility" Value="Collapsed"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource CardHover}"/></Trigger></Style.Triggers>
    </Style>
    <!-- Primary: one per screen -->
    <Style x:Key="BtnCta" TargetType="t:Btn" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="{DynamicResource Cta}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource CtaInk}"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Glint" Value="True"/>
      <Setter Property="Padding" Value="22,0"/>
      <Setter Property="FontSize" Value="15.5"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Cta}"/></Trigger></Style.Triggers>
    </Style>

    <Style x:Key="Switch" TargetType="t:Switch">
      <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="t:Switch">
            <Grid Width="60" Height="34" Background="Transparent">
              <Border Background="{DynamicResource Off}" CornerRadius="17"/>
              <Border x:Name="live" Background="{DynamicResource On}" CornerRadius="17" Opacity="0"/>
              <Border x:Name="knob" Width="26" Height="26" Margin="4" HorizontalAlignment="Left" CornerRadius="13" Background="{DynamicResource Knob}">
                <Viewbox Width="14" Height="14"><Path x:Name="tick" Data="{StaticResource IcoCheck}" Stroke="{DynamicResource OnInk}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="24" Height="24" Opacity="0"/></Viewbox>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding State, RelativeSource={RelativeSource Self}}" Value="True"><Setter TargetName="tick" Property="Opacity" Value="1"/><Setter TargetName="tick" Property="Stroke" Value="{DynamicResource On}"/><Setter TargetName="knob" Property="Background" Value="{DynamicResource OnInk}"/></DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="12"/>
      <Setter Property="MinWidth" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb MinHeight="44"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="t" Background="{DynamicResource Ink}" Opacity="0.35" CornerRadius="4" Margin="2,0"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="Opacity" Value="0.7"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Ink}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource On}"/>
      <Setter Property="SelectionOpacity" Value="0.5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding Background}" BorderThickness="2" CornerRadius="13" Padding="12,0">
              <Grid>
                <TextBlock x:Name="hint" Text="{TemplateBinding Tag}" Foreground="{DynamicResource Ink2}" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" Margin="2,2,2,0"/>
                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="0,2,0,0"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Text" Value=""><Setter TargetName="hint" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Ink}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The Windows template paints the list white when it is disabled. -->
    <ControlTemplate x:Key="PlainList" TargetType="ListBox">
      <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"><ItemsPresenter/></ScrollViewer>
    </ControlTemplate>
    <ControlTemplate x:Key="BareList" TargetType="ListBox"><ItemsPresenter/></ControlTemplate>

    <Style x:Key="Skel" TargetType="ContentControl">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl"><Grid><Border Background="{DynamicResource Card}" CornerRadius="12"/><Border Background="{DynamicResource Shimmer}" CornerRadius="12"/></Grid></ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="BareItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- Option with name and note -->
    <!-- Tertiary: text and icon only -->
    <Style x:Key="LinkBtn" TargetType="t:Btn">
      <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="t:Btn"><Border Background="Transparent" Padding="2,6"><StackPanel Orientation="Horizontal"><Viewbox x:Name="ic" Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center"><Path Data="{TemplateBinding Icon}" Stroke="{TemplateBinding Foreground}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="24" Height="24"/></Viewbox><TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Center" Margin="0,2,0,0"/></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="Icon" Value="{x:Null}"><Setter TargetName="ic" Property="Visibility" Value="Collapsed"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- Choice among options: the chosen one is filled with On -->
    <Style x:Key="ChipItem" TargetType="ListBoxItem">
      <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="b" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1.5" CornerRadius="14" Padding="13.5,9.5" Margin="0,0,8,8">
              <StackPanel>
                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Typography.NumeralAlignment="Tabular"/>
                <TextBlock x:Name="nt" Text="{Binding Note}" Foreground="{DynamicResource Ink2}" FontSize="13"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource CardHover}"/></Trigger>
              <DataTrigger Binding="{Binding Note}" Value="{x:Null}"><Setter TargetName="nt" Property="Visibility" Value="Collapsed"/></DataTrigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource On}"/><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource On}"/><Setter Property="Foreground" Value="{DynamicResource OnInk}"/><Setter TargetName="nt" Property="Foreground" Value="{DynamicResource OnInk}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Dropdown: field with a chevron that turns when the popup below opens -->
    <Style x:Key="Drop" TargetType="t:Drop">
      <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="MinWidth" Value="240"/>
      <Setter Property="MaxWidth" Value="360"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="t:Drop">
            <Grid>
              <Border x:Name="b" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1.5" CornerRadius="12" Padding="14,0,12,0">
                <DockPanel>
                  <Viewbox x:Name="chev" DockPanel.Dock="Right" Width="18" Height="18" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><Path Data="{StaticResource IcoDown}" Stroke="{DynamicResource Ink2}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="24" Height="24"/></Viewbox>
                  <ContentPresenter VerticalAlignment="Center" Margin="0,2,10,0"/>
                </DockPanel>
              </Border>
              <Popup x:Name="pop" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Placement="Bottom" VerticalOffset="6" AllowsTransparency="True" StaysOpen="True" PopupAnimation="None" Focusable="False">
                <Border x:Name="card" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1.5" CornerRadius="14" Padding="6" MinWidth="240" Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" TextElement.Foreground="{DynamicResource Ink}">
                  <ContentPresenter Content="{TemplateBinding Panel}"/>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource CardHover}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Dropdown row: icon, name and a short note -->
    <Style x:Key="DropItem" TargetType="ListBoxItem">
      <Setter Property="FocusVisualStyle"><Setter.Value><Style><Setter Property="Control.Template"><Setter.Value><ControlTemplate><Rectangle Stroke="{DynamicResource Ink}" StrokeThickness="1.5" RadiusX="8" RadiusY="8"/></ControlTemplate></Setter.Value></Setter></Style></Setter.Value></Setter>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid Height="40">
              <Border x:Name="hov" CornerRadius="8" Background="{DynamicResource CardHover}" Visibility="Hidden"/>
              <Border x:Name="sel" CornerRadius="8" Background="{DynamicResource Line}" Opacity="0.4" Visibility="Hidden"/>
              <DockPanel Margin="10,0,12,0">
                <TextBlock x:Name="nt" DockPanel.Dock="Right" Text="{Binding Note}" Foreground="{DynamicResource Ink2}" FontSize="13" FontWeight="Normal" VerticalAlignment="Center" Margin="12,2,0,0"/>
                <ContentPresenter VerticalAlignment="Center"/>
              </DockPanel>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="hov" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="sel" Property="Visibility" Value="Visible"/></Trigger>
              <DataTrigger Binding="{Binding Note}" Value="{x:Null}"><Setter TargetName="nt" Property="Visibility" Value="Collapsed"/></DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="IconFace">
      <StackPanel Orientation="Horizontal">
        <Viewbox Width="22" Height="22" VerticalAlignment="Center"><Path x:Name="p" Data="{Binding Icon}" Stroke="{DynamicResource On}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="24" Height="24"/></Viewbox>
        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="10,2,0,0"/>
      </StackPanel>
      <DataTemplate.Triggers><DataTrigger Binding="{Binding Muted}" Value="True"><Setter TargetName="p" Property="Stroke" Value="{DynamicResource Ink2}"/></DataTrigger></DataTemplate.Triggers>
    </DataTemplate>
    <!-- Resolution dropdown: the closed field with ratio, Hz and the recommended tag; rows that do not apply stay faded -->
    <DataTemplate x:Key="ResFace">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Ink2}" FontSize="13.5" FontWeight="Normal" VerticalAlignment="Center" Margin="10,1,0,0"/>
        <Border x:Name="tag" Background="{DynamicResource On}" CornerRadius="6" Padding="7,1,7,2" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"><TextBlock Text="Recomendada" Foreground="{DynamicResource OnInk}" FontSize="11.5" FontWeight="SemiBold"/></Border>
      </StackPanel>
      <DataTemplate.Triggers><DataTrigger Binding="{Binding Best}" Value="True"><Setter TargetName="tag" Property="Visibility" Value="Visible"/></DataTrigger></DataTemplate.Triggers>
    </DataTemplate>
    <Style x:Key="ResItem" TargetType="ListBoxItem" BasedOn="{StaticResource DropItem}"/>

    <Style x:Key="GameItem" TargetType="ListBoxItem">
      <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border Background="Transparent" Height="40"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0"/></Border></ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource OnInk}"/></Trigger></Style.Triggers>
    </Style>

    <Style x:Key="SldSide" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"><Border Height="8" CornerRadius="4" Background="{TemplateBinding Background}"/></Border></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Sld" TargetType="Slider">
      <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource SldSide}" Command="Slider.DecreaseLarge" Background="{DynamicResource On}"/></Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource SldSide}" Command="Slider.IncreaseLarge" Background="{DynamicResource Off}"/></Track.IncreaseRepeatButton>
              <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Width="24" Height="24" Fill="{DynamicResource Knob}" Stroke="{DynamicResource On}" StrokeThickness="5"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
            </Track>
            <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="NavItem" TargetType="ListBoxItem">
      <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="b" Background="Transparent" Padding="14,0" Height="44" CornerRadius="12"><Grid><ContentPresenter x:Name="cp" VerticalAlignment="Center"/><Border x:Name="rule" Height="1" Background="{DynamicResource Line}" Visibility="Collapsed"/></Grid></Border>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding Small}" Value="True"><Setter TargetName="b" Property="Height" Value="29"/><Setter TargetName="b" Property="Padding" Value="34,0,14,0"/></DataTrigger>
              <!-- Line between the Tweaks shortcuts and the categories: 1 px, 6 above and below -->
              <DataTrigger Binding="{Binding Rule}" Value="True"><Setter TargetName="b" Property="Height" Value="13"/><Setter TargetName="cp" Property="Visibility" Value="Collapsed"/><Setter TargetName="rule" Property="Visibility" Value="Visible"/></DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <!-- Active section: On text and icon over the NavMark card -->
      <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource On}"/></Trigger>
        <DataTrigger Binding="{Binding Rule}" Value="True"><Setter Property="IsEnabled" Value="False"/><Setter Property="Focusable" Value="False"/><Setter Property="Cursor" Value="Arrow"/></DataTrigger></Style.Triggers>
    </Style>

    <Style x:Key="Check" TargetType="CheckBox">
      <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent" Height="42">
              <Border x:Name="box" Width="24" Height="24" Background="{DynamicResource Off}" BorderBrush="{DynamicResource Line}" BorderThickness="1.5" CornerRadius="8" VerticalAlignment="Center">
                <Viewbox Width="14" Height="14"><Path x:Name="tick" Data="{StaticResource IcoCheck}" Stroke="{DynamicResource OnInk}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="24" Height="24" Visibility="Hidden"/></Viewbox>
              </Border>
              <ContentPresenter Margin="10,2,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="tick" Property="Visibility" Value="Visible"/><Setter TargetName="box" Property="Background" Value="{DynamicResource On}"/><Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource On}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Section and card header: small uppercase label above the content -->
    <Style x:Key="Head" TargetType="Label">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Label"><ContentPresenter Content="{TemplateBinding Content, Converter={StaticResource Upper}}"/></ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="PartCard" TargetType="ContentControl">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContentControl">
            <Border Background="{DynamicResource Card}" CornerRadius="18" Padding="18,16">
              <DockPanel>
                <Border Width="54" Height="54" CornerRadius="16" Background="{DynamicResource Rail}" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0"><Viewbox Width="28" Height="28"><Path Data="{Binding Icon}" Style="{StaticResource Ico}"/></Viewbox></Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding Main}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding Sub}" Foreground="{DynamicResource Ink2}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
              </DockPanel>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid x:Name="Shell" Background="{DynamicResource Bg}">
    <!-- Theme background: 320 × 180 pixel art, scaled up without smoothing -->
    <Image x:Name="Scene" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="NearestNeighbor" IsHitTestVisible="False" Visibility="Collapsed"/>
    <Grid x:Name="Main">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="292"/>
      </Grid.ColumnDefinitions>
      <!-- BgA and RailA let the theme background through; with Simple they are solid -->
      <Border Grid.Column="1" Background="{DynamicResource BgA}"/>

      <!-- Navigation -->
      <DockPanel Grid.Column="0" Background="{DynamicResource RailA}">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,20,16,14">
          <Viewbox Width="28" Height="42" VerticalAlignment="Center"><Canvas Width="38" Height="57"><Canvas Margin="-13,-3.5,0,0"><Canvas x:Name="LogoEars" RenderTransformOrigin="0.5,1" Width="64" Height="28"><Path Data="{StaticResource LogoEarsShape}" Fill="{DynamicResource On}"/><Path Data="{StaticResource LogoInner}" Fill="{DynamicResource Cta}"/></Canvas><Path Data="{StaticResource LogoHead}" Fill="{DynamicResource On}"/><Path Data="{StaticResource LogoFace}" Fill="{DynamicResource Rail}"/></Canvas></Canvas></Viewbox>
          <TextBlock Text="Tweakeroo" FontSize="27" FontWeight="Bold" Margin="12,3,0,0"/>
        </StackPanel>
        <Border x:Name="GameBox" DockPanel.Dock="Top" Margin="16,0,16,14" Background="{DynamicResource Off}" CornerRadius="14" Padding="4">
          <Grid>
            <Border x:Name="GameMark" Background="{DynamicResource On}" CornerRadius="11" HorizontalAlignment="Left"/>
            <ListBox x:Name="Games" Template="{StaticResource BareList}" ItemContainerStyle="{StaticResource GameItem}" Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.Name="Juego">
              <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ListBox.ItemsPanel>
              <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold"/></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
        <StackPanel DockPanel.Dock="Bottom" Margin="22,10,16,16">
          <TextBlock x:Name="ThemeName" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <ListBox x:Name="Themes" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0" Padding="0" Margin="-4,0,0,0" AutomationProperties.Name="Temática">
            <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
                <Setter Property="ToolTip" Value="{Binding Title}"/>
                <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="ring" CornerRadius="10" BorderThickness="2.5" BorderBrush="Transparent" Padding="2.5" Margin="0,0,2,0">
                        <Grid Width="46" Height="26">
                          <!-- Simple: plain colors, shown as the swatch of the palette in use -->
                          <Border CornerRadius="6" Background="{Binding Pal.Base}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                            <Viewbox Width="16" Height="16"><Grid Width="24" Height="24"><Ellipse Fill="{Binding Pal.Base}" Stroke="{DynamicResource Ink}" StrokeThickness="1"/><Path Data="M12,1 A11,11 0 0 1 12,23 Z" Fill="{Binding Pal.Accent}"/><Ellipse Width="10" Height="10" Fill="{Binding Pal.Live}"/></Grid></Viewbox>
                          </Border>
                          <Image Source="{Binding Thumb}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Clip><RectangleGeometry Rect="0,0,46,26" RadiusX="6" RadiusY="6"/></Image.Clip>
                          </Image>
                        </Grid>
                      </Border>
                      <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource Ink}"/></Trigger></ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
          </ListBox>
          <StackPanel x:Name="PaletteBox" Margin="0,10,0,0">
          <TextBlock x:Name="PaletteName" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <Border x:Name="PaletteZone" Background="Transparent" Height="44">
          <ListBox x:Name="Palettes" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0" Padding="0" Margin="-4,0,0,0">
            <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
                <Setter Property="ToolTip" Value="{Binding Name}"/>
                <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="ring" Width="34" Height="34" CornerRadius="17" BorderThickness="2.5" BorderBrush="Transparent" Padding="2.5" Margin="0" VerticalAlignment="Center">
                        <Grid Width="24" Height="24">
                          <Ellipse Fill="{Binding Base}" Stroke="{DynamicResource Ink}" StrokeThickness="1"/>
                          <Path Data="M12,1 A11,11 0 0 1 12,23 Z" Fill="{Binding Accent}"/>
                          <Ellipse Width="10" Height="10" Fill="{Binding Live}"/>
                        </Grid>
                      </Border>
                      <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource Ink}"/></Trigger></ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
          </ListBox>
          </Border>
          </StackPanel>
          <t:Btn x:Name="OpenSettings" Style="{StaticResource Btn}" Icon="{StaticResource IcoGear}" Content="Ajustes" Height="38" HorizontalAlignment="Left" Margin="0,8,0,0"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
          <Grid Margin="12,0">
            <Border x:Name="NavMark" Visibility="Hidden" Height="44" CornerRadius="0,12,12,0" Background="{DynamicResource Card}" VerticalAlignment="Top"><Border Width="3" HorizontalAlignment="Left" CornerRadius="0,1.5,1.5,0" Background="{DynamicResource On}"/></Border>
            <ListBox x:Name="Circuits" Template="{StaticResource BareList}" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel>
                    <Viewbox Width="{Binding IconSize}" Height="{Binding IconSize}" DockPanel.Dock="Left" Margin="0,0,13,0"><Path Data="{Binding Icon}" Style="{StaticResource Ico}"/></Viewbox>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" FontSize="13" Margin="8,2,0,0" Foreground="{DynamicResource Ink2}" Typography.NumeralAlignment="Tabular"/>
                    <Viewbox DockPanel.Dock="Right" Width="16" Height="16" Visibility="{Binding HasSubs, Converter={StaticResource Vis}}"><Path x:Name="Chevron" Data="M5,9 L12,16 L19,9" Style="{StaticResource Ico}" StrokeThickness="3"/></Viewbox>
                    <TextBlock Text="{Binding Name}" FontSize="{Binding Size}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <!-- Opaque so the menu loading underneath never shows through the bars -->
            <StackPanel x:Name="SkelNav" Visibility="Collapsed" Background="{DynamicResource Rail}">
              <ContentControl Style="{StaticResource Skel}" Width="150" Height="24" Margin="14,10" HorizontalAlignment="Left"/>
              <ContentControl Style="{StaticResource Skel}" Width="120" Height="24" Margin="14,10" HorizontalAlignment="Left"/>
              <ContentControl Style="{StaticResource Skel}" Width="134" Height="24" Margin="14,10" HorizontalAlignment="Left"/>
              <ContentControl Style="{StaticResource Skel}" Width="126" Height="24" Margin="14,10" HorizontalAlignment="Left"/>
              <ContentControl Style="{StaticResource Skel}" Width="104" Height="24" Margin="14,10" HorizontalAlignment="Left"/>
              <ContentControl Style="{StaticResource Skel}" Width="116" Height="24" Margin="14,10" HorizontalAlignment="Left"/>
              <ContentControl Style="{StaticResource Skel}" Width="138" Height="24" Margin="14,10" HorizontalAlignment="Left"/>
              <ContentControl Style="{StaticResource Skel}" Width="110" Height="24" Margin="14,10" HorizontalAlignment="Left"/>
              <ContentControl Style="{StaticResource Skel}" Width="122" Height="24" Margin="14,10" HorizontalAlignment="Left"/>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </DockPanel>

      <!-- My PC -->
      <ScrollViewer x:Name="PcPage" Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="Hidden">
        <StackPanel Margin="28,24,20,110">
          <TextBlock x:Name="PcTitle" Text="Prepara tu PC para jugar" FontSize="32" FontWeight="Bold" TextWrapping="Wrap"/>
          <TextBlock x:Name="PcText" Foreground="{DynamicResource Ink2}" FontSize="15" TextWrapping="Wrap" Margin="0,6,0,18" MaxWidth="560" HorizontalAlignment="Left"/>
          <WrapPanel Margin="0,0,0,24">
            <t:Btn x:Name="Scan" Style="{StaticResource BtnCta}" Icon="{StaticResource IcoScan}" Content="Escanear PC" Margin="0,0,10,10"/>
            <t:Btn x:Name="Rescan" Style="{StaticResource Btn}" Icon="{StaticResource IcoScan}" Content="Volver a escanear" Margin="0,0,10,10" Visibility="Collapsed"/>
            <t:Btn x:Name="ShowRec" Style="{StaticResource Btn}" Icon="{StaticResource IcoEye}" Content="Ver lista" Margin="0,0,10,10" Visibility="Collapsed"/>
          </WrapPanel>
          <Grid x:Name="Meter" Height="16" Margin="0,0,0,8">
            <Border Background="{DynamicResource Rail}" CornerRadius="8"/>
            <Border x:Name="MeterFill" Background="{DynamicResource On}" CornerRadius="8" Visibility="Hidden"/>
          </Grid>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
            <TextBlock x:Name="TotalOn" FontSize="17" FontWeight="Bold" Typography.NumeralAlignment="Tabular"/>
            <TextBlock x:Name="TotalText" FontSize="15" Foreground="{DynamicResource Ink2}" Margin="6,2,0,0"/>
          </StackPanel>
          <ItemsControl x:Name="Parts" Focusable="False" Margin="0,0,-10,0">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate><ContentControl Style="{StaticResource PartCard}" Margin="0,0,10,10"/></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl x:Name="Notes" Focusable="False" Margin="0,14,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,0,10,12">
                  <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource On}" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,0,14,0"><Viewbox Width="14" Height="14"><Path Data="{StaticResource IcoCheck}" Stroke="{DynamicResource OnInk}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="24" Height="24"/></Viewbox></Border>
                  <TextBlock Text="{Binding}" FontSize="15" TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <WrapPanel Margin="0,16,0,0">
            <t:Btn x:Name="AllOn" Style="{StaticResource Btn}" Icon="{StaticResource IcoPower}" Content="Activar todo" ToolTip="Activa todos los tweaks menos los de riesgo" Margin="0,0,10,10"/>
            <t:Btn x:Name="AllOff" Style="{StaticResource Btn}" Icon="{StaticResource IcoUndo}" Content="Deshacer todo" ToolTip="Quita lo que activó Tweakeroo. Lo que ya estaba así antes no se toca" Margin="0,0,10,10"/>
          </WrapPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- Play -->
      <ScrollViewer x:Name="StretchPage" Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="Collapsed">
        <StackPanel Margin="28,24,28,110">
          <TextBlock Text="Jugar" FontSize="32" FontWeight="Bold" TextWrapping="Wrap"/>
          <TextBlock x:Name="PlayText" Foreground="{DynamicResource Ink2}" FontSize="15" TextWrapping="Wrap" Margin="0,6,0,18" MaxWidth="580" HorizontalAlignment="Left"/>
          <WrapPanel Margin="0,0,0,12">
            <t:Btn x:Name="Play" Style="{StaticResource BtnCta}" Icon="{StaticResource IcoGame}" Margin="0,0,14,10"/>
            <t:Btn x:Name="Back" Style="{StaticResource Btn}" Icon="{StaticResource IcoUndo}" Content="Restaurar resolución" Margin="0,0,10,10" Visibility="Collapsed"/>
          </WrapPanel>
          <UniformGrid Rows="1" Margin="0,0,-8,24">
            <Border Background="{DynamicResource Card}" CornerRadius="18" Padding="18,12" Margin="0,0,8,0"><StackPanel><TextBlock x:Name="PlayEstLabel" Text="FPS estimados" Visibility="Collapsed"/><Label Style="{StaticResource Head}" Content="{Binding Text, ElementName=PlayEstLabel}"/><TextBlock x:Name="PlayEst" Text="…" FontSize="24" FontWeight="Bold"/></StackPanel></Border>
            <Border Background="{DynamicResource Card}" CornerRadius="18" Padding="18,12" Margin="0,0,8,0"><StackPanel><Label Style="{StaticResource Head}" Content="Última partida"/><TextBlock x:Name="PlayLast" Text="…" FontSize="24" FontWeight="Bold"/></StackPanel></Border>
            <Border Background="{DynamicResource Card}" CornerRadius="18" Padding="18,12" Margin="0,0,8,0"><StackPanel><Label Style="{StaticResource Head}" Content="Memoria libre"/><TextBlock x:Name="PlayRam" Text="…" FontSize="24" FontWeight="Bold"/></StackPanel></Border>
          </UniformGrid>
          <Label Style="{StaticResource Head}" Content="Resolución" Margin="0,0,0,10"/>
          <t:Drop x:Name="ResOpen" Style="{StaticResource Drop}" ContentTemplate="{StaticResource ResFace}" Width="380" MaxWidth="380" AutomationProperties.Name="Elegir resolución"><t:Drop.Panel><ListBox x:Name="ResOpenList" Template="{StaticResource PlainList}" MaxHeight="360" ItemContainerStyle="{StaticResource ResItem}" DisplayMemberPath="Name" Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.Name="Elegir resolución"/></t:Drop.Panel></t:Drop>
          <Label x:Name="LimitTitle" Style="{StaticResource Head}" Content="Límite de FPS" Margin="0,24,0,10"/>
          <ListBox x:Name="Limits" Template="{StaticResource BareList}" ItemContainerStyle="{StaticResource ChipItem}" Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.Name="Límite de FPS">
            <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Margin="0,0,-8,0"/></ItemsPanelTemplate></ListBox.ItemsPanel>
          </ListBox>
          <CheckBox x:Name="Minimize" Style="{StaticResource Check}" Content="Minimizar Tweakeroo mientras juegas" FontSize="15" Margin="0,8,0,0"/>
          <Label Style="{StaticResource Head}" Content="Programas con más uso de memoria" Margin="0,20,0,2"/>
          <TextBlock Text="Cerrar los que no se usen libera memoria antes de jugar." Foreground="{DynamicResource Ink2}" Margin="0,0,0,10"/>
          <ItemsControl x:Name="Heavy" Focusable="False">
            <ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource Card}" CornerRadius="12" Padding="18,10" Margin="0,0,0,4"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontWeight="Bold" Typography.NumeralAlignment="Tabular"/><TextBlock Text="{Binding Key}"/></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <!-- Stretched Resolution -->
      <ScrollViewer x:Name="ResPage" Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="Collapsed">
        <StackPanel Margin="28,24,28,110">
          <TextBlock Text="Stretched Resolution" FontSize="32" FontWeight="Bold" TextWrapping="Wrap"/>
          <TextBlock x:Name="ResHint" Foreground="{DynamicResource Ink2}" FontSize="15" TextWrapping="Wrap" Margin="0,6,0,18" MaxWidth="620" HorizontalAlignment="Left"/>
          <Border x:Name="ValBox" Background="{DynamicResource Card}" CornerRadius="16" Padding="18,12" Margin="0,0,0,20" Visibility="Collapsed"><DockPanel><CheckBox x:Name="ValOn" DockPanel.Dock="Right" Style="{StaticResource Check}" AutomationProperties.Name="Estirar Valorant" Margin="16,0,0,0" VerticalAlignment="Center"/><StackPanel VerticalAlignment="Center"><TextBlock Text="Estirar Valorant" FontSize="16" FontWeight="Bold"/><TextBlock Text="Cambia la resolución de Windows al cargar un mapa. No toca la memoria del juego. Riot no ha publicado una norma clara sobre esto: se usa bajo responsabilidad propia." Foreground="{DynamicResource Ink2}" TextWrapping="Wrap" Margin="0,2,0,0"/></StackPanel></DockPanel></Border>
          <StackPanel x:Name="ResBox">
          <DockPanel Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,10,0">
              <StackPanel Margin="0,0,12,0"><Border x:Name="FigureBoxA" Width="148" Height="210" CornerRadius="16" RenderOptions.BitmapScalingMode="HighQuality"><Border.Background><ImageBrush x:Name="FigureNormal" Stretch="UniformToFill"/></Border.Background></Border><TextBlock Text="Normal" FontSize="13" HorizontalAlignment="Center" Foreground="{DynamicResource Ink2}" Margin="0,6,0,0"/></StackPanel>
              <StackPanel Margin="0,0,12,0"><Border x:Name="FigureBoxB" Width="148" Height="210" CornerRadius="16" RenderOptions.BitmapScalingMode="HighQuality"><Border.Background><ImageBrush x:Name="FigureWide" Stretch="UniformToFill"><ImageBrush.RelativeTransform><ScaleTransform x:Name="FigureScale" CenterX="0.5"/></ImageBrush.RelativeTransform></ImageBrush></Border.Background></Border><TextBlock Text="Stretched" FontSize="13" HorizontalAlignment="Center" Foreground="{DynamicResource Ink2}" Margin="0,6,0,0"/></StackPanel>
            </StackPanel>
            <TextBlock x:Name="StretchInfo" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
          </DockPanel>
          <t:Drop x:Name="ResDrop" Style="{StaticResource Drop}" ContentTemplate="{StaticResource ResFace}" Width="380" MaxWidth="380" AutomationProperties.Name="Resolución"><t:Drop.Panel><ListBox x:Name="Resolutions" Template="{StaticResource PlainList}" MaxHeight="360" ItemContainerStyle="{StaticResource ResItem}" DisplayMemberPath="Name" Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.Name="Resolución"/></t:Drop.Panel></t:Drop>
