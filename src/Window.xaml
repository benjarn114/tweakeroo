          <StackPanel x:Name="SetupStep1" Orientation="Horizontal" Margin="0,0,0,22"><Grid Width="34" Height="34"><Border CornerRadius="17" Background="{DynamicResource Card}"/><Border x:Name="StepOn1" CornerRadius="17" Background="{DynamicResource On}" Opacity="0"/><TextBlock Text="1" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Style.Triggers><DataTrigger Binding="{Binding Opacity, ElementName=StepOn1}" Value="1"><Setter Property="Foreground" Value="{DynamicResource OnInk}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><TextBlock Text="Qué hace" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,2,0,0"/></StackPanel>
          <StackPanel x:Name="SetupStep2" Orientation="Horizontal" Margin="0,0,0,22"><Grid Width="34" Height="34"><Border CornerRadius="17" Background="{DynamicResource Card}"/><Border x:Name="StepOn2" CornerRadius="17" Background="{DynamicResource On}" Opacity="0"/><TextBlock Text="2" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Style.Triggers><DataTrigger Binding="{Binding Opacity, ElementName=StepOn2}" Value="1"><Setter Property="Foreground" Value="{DynamicResource OnInk}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><TextBlock Text="Términos" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,2,0,0"/></StackPanel>
          <StackPanel x:Name="SetupStep3" Orientation="Horizontal"><Grid Width="34" Height="34"><Border CornerRadius="17" Background="{DynamicResource Card}"/><Border x:Name="StepOn3" CornerRadius="17" Background="{DynamicResource On}" Opacity="0"/><TextBlock Text="3" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Style.Triggers><DataTrigger Binding="{Binding Opacity, ElementName=StepOn3}" Value="1"><Setter Property="Foreground" Value="{DynamicResource OnInk}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><TextBlock Text="Instalar" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,2,0,0"/></StackPanel>
        </StackPanel>
      </DockPanel>

      <ScrollViewer x:Name="SetupWelcome" Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="Collapsed">
