      <!-- Aviso -->
      <Border x:Name="Toast" Grid.Column="1" Background="{DynamicResource Ink}" CornerRadius="18" Padding="20,14" Margin="28,0,28,22" HorizontalAlignment="Center" VerticalAlignment="Bottom" MaxWidth="620" IsHitTestVisible="False" Opacity="0">
        <StackPanel>
          <TextBlock x:Name="Status" Foreground="{DynamicResource Rail}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
          <Grid x:Name="Progress" Height="6" Margin="0,10,0,0" MinWidth="320" Visibility="Collapsed">
            <Border Background="{DynamicResource Rail}" Opacity="0.25" CornerRadius="3"/>
            <Border x:Name="ProgressFill" Background="{DynamicResource Rail}" CornerRadius="3" RenderTransformOrigin="0,0.5"><Border.RenderTransform><ScaleTransform ScaleX="0"/></Border.RenderTransform></Border>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
    <!-- Instalacion -->
    <Grid x:Name="Setup" Background="{DynamicResource Bg}" Visibility="Collapsed">
      <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <DockPanel Background="{DynamicResource Rail}">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="26,28,16,44">
          <Viewbox Width="28" Height="42" VerticalAlignment="Center"><Canvas Width="38" Height="57"><Canvas Margin="-13,-3.5,0,0"><Canvas Width="64" Height="28"><Path Data="{StaticResource LogoEarsShape}" Fill="{DynamicResource On}"/><Path Data="{StaticResource LogoInner}" Fill="{DynamicResource Cta}"/></Canvas><Path Data="{StaticResource LogoHead}" Fill="{DynamicResource On}"/><Path Data="{StaticResource LogoFace}" Fill="{DynamicResource Rail}"/></Canvas></Canvas></Viewbox>
          <TextBlock Text="Tweakeroo" FontSize="27" FontWeight="Bold" Margin="12,3,0,0"/>
        </StackPanel>
        <TextBlock x:Name="SetupVersion" DockPanel.Dock="Bottom" Foreground="{DynamicResource Ink2}" Margin="26,0,0,26"/>
