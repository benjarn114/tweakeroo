              <StackPanel>
                <TextBlock x:Name="FpsLast" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <WrapPanel Margin="0,10,0,0">
                  <StackPanel Margin="0,0,44,0"><TextBlock x:Name="FpsMedian" FontSize="56" FontWeight="Bold" Typography.NumeralAlignment="Tabular"/><TextBlock Text="FPS la mitad del tiempo o más" Foreground="{DynamicResource Ink2}"/></StackPanel>
