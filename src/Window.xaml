                  <StackPanel Margin="0,0,44,0"><TextBlock x:Name="FpsMedian" FontSize="56" FontWeight="Bold" Typography.NumeralAlignment="Tabular"/><TextBlock Text="FPS la mitad del tiempo o más" Foreground="{DynamicResource Ink2}"/></StackPanel>
                  <StackPanel Margin="0,24,44,0"><TextBlock x:Name="FpsLow" FontSize="32" FontWeight="Bold" Typography.NumeralAlignment="Tabular"/><TextBlock Text="en los peores momentos" Foreground="{DynamicResource Ink2}"/></StackPanel>
                  <StackPanel Margin="0,24,0,0"><TextBlock x:Name="FpsMax" FontSize="32" FontWeight="Bold" Typography.NumeralAlignment="Tabular"/><TextBlock Text="máximo" Foreground="{DynamicResource Ink2}"/></StackPanel>
