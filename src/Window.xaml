              <TextBlock Grid.Column="2" Text="Peores" Foreground="{DynamicResource Ink2}" FontSize="13" TextAlignment="Right"/>
              <TextBlock Grid.Column="3" Text="Máximo" Foreground="{DynamicResource Ink2}" FontSize="13" TextAlignment="Right"/>
              <TextBlock Grid.Column="4" Text="Límite" Foreground="{DynamicResource Ink2}" FontSize="13" TextAlignment="Right"/>
            </Grid>
            <ItemsControl x:Name="FpsRows" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource Card}" CornerRadius="12" Padding="18,10" Margin="0,0,0,4">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="178"/><ColumnDefinition Width="*"/><ColumnDefinition Width="54"/><ColumnDefinition Width="66"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding When}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/><TextBlock Text="{Binding Map}" Foreground="{DynamicResource Ink2}" Margin="8,0,0,0"/></StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal"><Border Background="{DynamicResource On}" Width="{Binding BarW}" Height="12" CornerRadius="4" VerticalAlignment="Center"/><TextBlock Text="{Binding Median}" FontWeight="Bold" Margin="8,2,0,0" Typography.NumeralAlignment="Tabular"/></StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding Low}" TextAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                      <TextBlock Grid.Column="3" Text="{Binding Max}" TextAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
