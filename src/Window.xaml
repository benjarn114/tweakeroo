          <TextBlock x:Name="UpText" Text="Analiza la configuración y los FPS. Primero las mejoras gratis; las compras, solo si el cambio es notable." Foreground="{DynamicResource Ink2}" FontSize="15" TextWrapping="Wrap" Margin="0,6,0,18" MaxWidth="580" HorizontalAlignment="Left"/>
          <t:Btn x:Name="Review" Style="{StaticResource BtnCta}" Icon="{StaticResource IcoScan}" Content="Revisar PC" HorizontalAlignment="Left" Margin="0,0,0,22"/>
          <ItemsControl x:Name="Checks" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource Card}" CornerRadius="18" Padding="18,14" Margin="0,0,0,8">
