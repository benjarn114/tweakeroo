                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          </StackPanel>
          <StackPanel Visibility="{Binding Visibility, ElementName=FpsNow}">
            <Label Style="{StaticResource Head}" Content="Antes y después de los tweaks" Margin="0,24,0,4"/>
            <TextBlock x:Name="FpsCompare" FontSize="15" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"/>
          </StackPanel>
          <StackPanel Visibility="{Binding Visibility, ElementName=FpsNow}">
            <Label Style="{StaticResource Head}" Content="Partidas" Margin="0,24,0,8"/>
