                    <Grid DockPanel.Dock="Left" Width="30" Height="30" VerticalAlignment="Center" Margin="0,0,16,0">
                      <Border CornerRadius="15" Background="{DynamicResource On}" Visibility="{Binding Ok, Converter={StaticResource Vis}}"><Viewbox Width="15" Height="15"><Path Data="{StaticResource IcoCheck}" Stroke="{DynamicResource OnInk}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="24" Height="24"/></Viewbox></Border>
                      <Border CornerRadius="15" BorderBrush="{DynamicResource Ink}" BorderThickness="2.5" Visibility="{Binding Todo, Converter={StaticResource Vis}}"/>
