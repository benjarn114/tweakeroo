          <TextBlock Text="Optimización de Windows para Fortnite" FontSize="40" FontWeight="Bold" TextWrapping="Wrap"/>
          <TextBlock Text="Gratis, sin anuncios y con todos los cambios reversibles." FontSize="17" Foreground="{DynamicResource Ink2}" TextWrapping="Wrap" Margin="0,8,0,34"/>
          <DockPanel Margin="0,0,0,22"><Viewbox Width="30" Height="30" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,2,20,0"><Path Data="{StaticResource IcoScan}" Stroke="{DynamicResource On}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="24" Height="24"/></Viewbox><StackPanel><TextBlock Text="Análisis de componentes" FontSize="18" FontWeight="Bold"/><TextBlock Text="Escanea el PC y recomienda los ajustes adecuados entre más de 170." FontSize="15" Foreground="{DynamicResource Ink2}" TextWrapping="Wrap" Margin="0,2,0,0"/></StackPanel></DockPanel>
          <DockPanel Margin="0,0,0,22"><Viewbox Width="30" Height="30" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,2,20,0"><Path Data="{StaticResource IcoUndo}" Stroke="{DynamicResource On}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="24" Height="24"/></Viewbox><StackPanel><TextBlock Text="Copia del estado original" FontSize="18" FontWeight="Bold"/><TextBlock Text="Cada ajuste se desactiva con su interruptor y el estado original se puede restaurar en cualquier momento." FontSize="15" Foreground="{DynamicResource Ink2}" TextWrapping="Wrap" Margin="0,2,0,0"/></StackPanel></DockPanel>
          <DockPanel Margin="0,0,0,22"><Viewbox Width="30" Height="30" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,2,20,0"><Path Data="{StaticResource IcoLaunch}" Stroke="{DynamicResource On}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="24" Height="24"/></Viewbox><StackPanel><TextBlock Text="Fortnite en stretched" FontSize="18" FontWeight="Bold"/><TextBlock Text="Abre el juego con la resolución elegida y restaura la anterior al cerrarlo." FontSize="15" Foreground="{DynamicResource Ink2}" TextWrapping="Wrap" Margin="0,2,0,0"/></StackPanel></DockPanel>
          <DockPanel Margin="0,0,0,36"><Viewbox Width="30" Height="30" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,2,20,0"><Path Data="{StaticResource IcoGauge}" Stroke="{DynamicResource On}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="24" Height="24"/></Viewbox><StackPanel><TextBlock Text="Medición de FPS" FontSize="18" FontWeight="Bold"/><TextBlock Text="Se leen de los registros del juego, sin modificarlo, e incluyen recomendaciones de mejora." FontSize="15" Foreground="{DynamicResource Ink2}" TextWrapping="Wrap" Margin="0,2,0,0"/></StackPanel></DockPanel>
          <t:Btn x:Name="SetupGo" Style="{StaticResource BtnCta}" Content="Continuar" HorizontalAlignment="Left"/>
        </StackPanel>
      </ScrollViewer>

      <Grid x:Name="SetupTerms" Grid.Column="1" Visibility="Collapsed">
        <DockPanel x:Name="SetupTermsBody" Margin="64,48,48,36" MaxWidth="820" HorizontalAlignment="Left">
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18"><TextBlock Text="Términos y privacidad" FontSize="36" FontWeight="Bold"/><TextBlock Text="Tweakeroo cambia ajustes de Windows. Lee los términos antes de continuar." FontSize="16" Foreground="{DynamicResource Ink2}" Margin="0,6,0,0"/></StackPanel>
          <DockPanel DockPanel.Dock="Bottom" Margin="0,18,0,0" LastChildFill="False">
            <CheckBox x:Name="TermsCheck" Style="{StaticResource Check}" Content="He leído y acepto los términos y la privacidad" FontSize="15" VerticalAlignment="Center"/>
            <t:Btn x:Name="TermsOk" DockPanel.Dock="Right" Style="{StaticResource BtnCta}" Content="Aceptar y seguir" IsEnabled="False"/>
          </DockPanel>
          <Border Background="{DynamicResource Card}" CornerRadius="18" Padding="4,10,6,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="TermsText" Margin="22,10,22,10"/></ScrollViewer>
          </Border>
        </DockPanel>
      </Grid>

      <Grid x:Name="SetupInstall" Grid.Column="1" Visibility="Collapsed">
        <StackPanel x:Name="SetupInstallBody" Margin="64,64,48,40" MaxWidth="680" HorizontalAlignment="Left">
          <TextBlock Text="Todo listo para instalar" FontSize="36" FontWeight="Bold" TextWrapping="Wrap"/>
          <TextBlock x:Name="InstallNote" Text="Se añade al menú Inicio y a Aplicaciones de Windows, desde donde se desinstala. No cambia ningún ajuste hasta que se active." FontSize="16" Foreground="{DynamicResource Ink2}" TextWrapping="Wrap" Margin="0,8,0,26"/>
          <StackPanel x:Name="InstallOptions">
            <Border Background="{DynamicResource Card}" CornerRadius="18" Padding="20,14" Margin="0,0,0,12"><StackPanel><TextBlock Text="Carpeta" Foreground="{DynamicResource Ink2}"/><TextBlock x:Name="InstallWhere" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0"/></StackPanel></Border>
            <CheckBox x:Name="InstallDesktop" Style="{StaticResource Check}" IsChecked="True" Content="Crear un acceso directo en el escritorio" FontSize="15" Margin="0,0,0,18"/>
          </StackPanel>
          <t:Btn x:Name="InstallGo" Style="{StaticResource BtnCta}" Icon="{StaticResource IcoSave}" Content="Instalar" HorizontalAlignment="Left"/>
        </StackPanel>
      </Grid>

      <Grid x:Name="SetupRemove" Grid.Column="1" Visibility="Collapsed">
        <StackPanel x:Name="SetupRemoveBody" Margin="64,64,48,40" MaxWidth="680" HorizontalAlignment="Left">
          <TextBlock Text="Desinstalar Tweakeroo" FontSize="36" FontWeight="Bold" TextWrapping="Wrap"/>
          <TextBlock x:Name="RemoveNote" Text="Opciones para los cambios aplicados." FontSize="16" Foreground="{DynamicResource Ink2}" TextWrapping="Wrap" Margin="0,8,0,20"/>
          <StackPanel x:Name="RemoveOptions" Margin="0,0,0,18">
            <CheckBox x:Name="RemoveRestore" Style="{StaticResource Check}" IsChecked="True" Content="Restaurar el PC al estado Original" FontSize="15"/>
            <CheckBox x:Name="RemoveData" Style="{StaticResource Check}" Content="Borrar también los guardados y el historial de FPS" FontSize="15"/>
          </StackPanel>
          <t:Btn x:Name="RemoveGo" Style="{StaticResource BtnCta}" Icon="{StaticResource IcoTrash}" Content="Desinstalar" HorizontalAlignment="Left"/>
        </StackPanel>
      </Grid>
    </Grid>

    <!-- Version nueva -->
    <Grid x:Name="UpdateBox" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Contained">
      <Border Background="{DynamicResource Rail}" Opacity="0.8"/>
      <Border x:Name="UpdateCard" Background="{DynamicResource Card}" CornerRadius="24" Padding="36,32" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock x:Name="UpdateTitle" FontSize="27" FontWeight="Bold" TextWrapping="Wrap"/>
          <TextBlock Text="Qué trae" FontSize="15" Foreground="{DynamicResource Ink2}" Margin="0,12,0,10"/>
          <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" Focusable="False">
            <ItemsControl x:Name="UpdateNotes" Focusable="False">
              <ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,0,10,10"><Ellipse Width="9" Height="9" Fill="{DynamicResource On}" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="2,6,14,0"/><TextBlock Text="{Binding}" FontSize="16" TextWrapping="Wrap"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <TextBlock x:Name="UpdateNote" Foreground="{DynamicResource Ink2}" TextWrapping="Wrap" Margin="0,8,0,22"/>
          <WrapPanel>
            <t:Btn x:Name="UpdateNow" Style="{StaticResource BtnCta}" Icon="{StaticResource IcoSave}" Content="Actualizar ahora" Margin="0,0,10,0"/>
            <t:Btn x:Name="UpdateLater" Style="{StaticResource Btn}" Content="Más tarde" Height="60"/>
          </WrapPanel>
        </StackPanel>
      </Border>
    </Grid>
    <Grid x:Name="InfoBox" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Contained">
      <Border x:Name="InfoShade" Background="{DynamicResource Rail}" Opacity="0.8"/>
      <Border x:Name="InfoCard" Background="{DynamicResource Bg}" CornerRadius="24" Padding="32,28" Width="640" Margin="0,40" HorizontalAlignment="Center" VerticalAlignment="Center">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18"><t:Btn x:Name="InfoClose" DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Cerrar"/><TextBlock x:Name="InfoTitle" FontSize="27" FontWeight="Bold" VerticalAlignment="Center"/></DockPanel>
          <ScrollViewer x:Name="InfoScroll" MaxHeight="520" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,14,0">
              <TextBlock x:Name="InfoText" TextWrapping="Wrap" FontSize="15" LineHeight="22"/>
              <ItemsControl x:Name="InfoVersions" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource Rail}" CornerRadius="18" Padding="22,18" Margin="0,0,0,10">
                      <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                          <TextBlock DockPanel.Dock="Right" Text="{Binding Date}" Foreground="{DynamicResource Ink2}" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Version}" FontSize="22" FontWeight="Bold"/>
                            <Border Background="{DynamicResource On}" CornerRadius="9" Padding="10,2" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding Current, Converter={StaticResource Vis}}"><TextBlock Text="Instalada" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource OnInk}"/></Border>
                          </StackPanel>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Notes}" Focusable="False">
                          <ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,0,0,7"><Ellipse Width="7" Height="7" Fill="{DynamicResource On}" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="2,7,12,0"/><TextBlock Text="{Binding}" FontSize="15" TextWrapping="Wrap"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
    <Image x:Name="Wipe" Stretch="Fill" IsHitTestVisible="False" Visibility="Collapsed"/>
  </Grid>
</Window>
