              <DataTemplate>
                <Border Background="{DynamicResource Rail}" CornerRadius="18" Padding="18,14" Margin="0,0,8,0">
                  <StackPanel>
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Range}" FontSize="30" FontWeight="Bold" Margin="0,4,0,0" Typography.NumeralAlignment="Tabular"/>
                    <TextBlock Text="{Binding Size}" Foreground="{DynamicResource Ink2}" FontSize="13"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Visibility="{Binding Visibility, ElementName=FpsNow}">
            <TextBlock Text="Antes y después de los tweaks" FontSize="20" FontWeight="Bold" Margin="0,24,0,4"/>
            <TextBlock x:Name="FpsCompare" FontSize="15" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"/>
          </StackPanel>
          <StackPanel Visibility="{Binding Visibility, ElementName=FpsNow}">
            <TextBlock Text="Partidas" FontSize="20" FontWeight="Bold" Margin="0,24,0,8"/>
