        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t="clr-namespace:Tablero;assembly={{ASM}}"
        Title="Tweakeroo" Width="1320" Height="840" MinWidth="1200" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}"
        FontFamily="Bahnschrift, Segoe UI" FontSize="14" UseLayoutRounding="True">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Vis"/>
    <t:Upper x:Key="Upper"/>

    <!-- Icons: single 2-unit stroke on a 24 grid -->
    <Geometry x:Key="IcoPc">M3,4 H21 V16 H3 Z M9,20 H15 M12,16 V20</Geometry>
    <Geometry x:Key="IcoAll">M4,4 H10 V10 H4 Z M14,4 H20 V10 H14 Z M4,14 H10 V20 H4 Z M14,14 H20 V20 H14 Z</Geometry>
    <Geometry x:Key="IcoGame">M7,7 H17 A5,5 0 0 1 22,12 V15 A3,3 0 0 1 16.5,16.5 L15,15 H9 L7.5,16.5 A3,3 0 0 1 2,15 V12 A5,5 0 0 1 7,7 Z M7,10 V13 M5.5,11.5 H8.5 M16,10.5 V10.6 M18,12.5 V12.6</Geometry>
    <Geometry x:Key="IcoGpu">M2,6 H22 V17 H2 Z M5,17 V20 H13 V17 M8,11.5 A2.5,2.5 0 1 0 13,11.5 A2.5,2.5 0 1 0 8,11.5 M17,9 V14</Geometry>
