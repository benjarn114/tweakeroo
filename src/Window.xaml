                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.VirtualizationMode="Recycling" KeyboardNavigation.TabNavigation="Continue">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border x:Name="plate" Background="{DynamicResource Card}" CornerRadius="18" Margin="0,0,16,8" Padding="18,14,20,14">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="88"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="132"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                      <t:Switch Style="{StaticResource Switch}" State="{Binding Checked}" AutomationProperties.Name="{Binding Spoken}" HorizontalAlignment="Left"/>
                      <TextBlock Text="{Binding StateText}" FontSize="12.5" FontWeight="SemiBold" Margin="0,5,0,0" Width="76" TextAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="4,0,16,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontSize="16.5" FontWeight="Bold" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding Desc}" FontSize="14" Foreground="{DynamicResource Ink2}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                      <TextBlock Text="{Binding AdviceText}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0" Visibility="{Binding HasAdvice, Converter={StaticResource Vis}}"/>
                      <TextBlock Text="{Binding Error}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,5,0,0" Visibility="{Binding HasError, Converter={StaticResource Vis}}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding EffectText}" FontSize="13.5" FontWeight="SemiBold" Margin="0,2,9,0"/>
                        <Border Width="5" Height="7" CornerRadius="2" Background="{DynamicResource Ink}" VerticalAlignment="Bottom" Margin="0,0,3,0"/>
                        <Border Width="5" Height="12" CornerRadius="2" Background="{DynamicResource Ink}" Opacity="{Binding Bar2}" VerticalAlignment="Bottom" Margin="0,0,3,0"/>
                        <Border Width="5" Height="17" CornerRadius="2" Background="{DynamicResource Ink}" Opacity="{Binding Bar3}" VerticalAlignment="Bottom"/>
                      </StackPanel>
                      <TextBlock Text="{Binding Note}" FontSize="13" Foreground="{DynamicResource Ink2}" TextAlignment="Right" TextWrapping="Wrap" Margin="0,5,0,0" Visibility="{Binding HasNote, Converter={StaticResource Vis}}"/>
                      <TextBlock Text="Riesgo" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource Danger}" TextAlignment="Right" Margin="0,5,0,0" Visibility="{Binding IsRisk, Converter={StaticResource Vis}}"/>
                    </StackPanel>
                  </Grid>
                </Border>
                <DataTemplate.Triggers><Trigger SourceName="plate" Property="IsMouseOver" Value="True"><Setter TargetName="plate" Property="Background" Value="{DynamicResource CardHover}"/></Trigger></DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </DockPanel>

      <!-- Guardados -->
      <DockPanel Grid.Column="2" Background="{DynamicResource Rail}">
