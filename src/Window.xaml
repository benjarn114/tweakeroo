                    <TextBlock DockPanel.Dock="Right" Text="{Binding Tag}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontSize="16.5" FontWeight="Bold" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding Text}" Foreground="{DynamicResource Ink2}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel x:Name="PlanBox" Visibility="Collapsed">
            <TextBlock Text="Próximas compras" FontSize="24" FontWeight="Bold" Margin="0,26,0,2"/>
