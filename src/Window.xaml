                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="16.5" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Text}" Foreground="{DynamicResource Ink2}" TextWrapping="Wrap" Margin="0,3,0,0"/>
